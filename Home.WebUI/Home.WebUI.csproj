<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a35e0d28-79e6-49e4-b06b-0f70f37898ad</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Data protection is not referenced here on purpose: the Microsoft.AspNetCore.App shared
         framework already ships it. -->
    <!-- Markdig renders recipe steps and notes. It is used from HomeMarkdown and nowhere else,
         because that component is the only place allowed to turn text into markup. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
  </ItemGroup>

  <!-- Runs before wwwroot is catalogued as static web assets, so the stylesheet it writes gets a
       fingerprint like every other file. On a clean clone the file did not exist when the project
       was evaluated, so it is added to Content here as well. -->
  <Target Name="BuildTailwind" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Content Include="wwwroot\css\app.css" Exclude="@(Content)" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
