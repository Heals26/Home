@* Modal dialog — slides up on mobile/tablet, centred on desktop. Use @bind-Visible for two-way binding. *@

@if (this.Visible)
{
    <div class="fixed inset-0 z-50 flex items-end sm:items-center justify-center">
        @* Backdrop *@
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm"
             @onclick="this.CloseAsync"></div>

        @* Panel *@
        <div class="relative w-full sm:max-w-lg bg-ink-900 rounded-t-2xl sm:rounded-2xl border border-ink-800 shadow-2xl z-10 max-h-[90vh] flex flex-col">
            @* Header *@
            <div class="flex items-center justify-between px-6 py-4 border-b border-ink-800 shrink-0">
                <h3 class="font-display text-xl text-ink-50">@this.Title</h3>
                <button class="text-ink-400 hover:text-ink-50 transition-colors p-2 -mr-2 rounded-lg min-h-[44px] min-w-[44px]"
                        @onclick="this.CloseAsync">
                    <span class="home-icon home-icon-x h-5 w-5 inline-block"></span>
                </button>
            </div>
            @* Body *@
            <div class="px-6 py-5 overflow-y-auto app-scrollable">
                @this.ChildContent
            </div>
            @* Footer *@
            @if (this.FooterContent != null)
            {
                <div class="px-6 py-4 border-t border-ink-800 shrink-0">
                    @this.FooterContent
                </div>
            }
        </div>
    </div>
}
