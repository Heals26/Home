@* Loading spinner. Sizes: sm, md (default), lg. *@

<div class="flex items-center justify-center @this.Class">
    <span class="inline-block border-2 border-ink-700 border-t-ink-200 rounded-full animate-spin @this.GetSizeClass()"></span>
    @if (!string.IsNullOrEmpty(this.Label))
    {
        <span class="ml-3 text-sm text-ink-400">@this.Label</span>
    }
</div>
