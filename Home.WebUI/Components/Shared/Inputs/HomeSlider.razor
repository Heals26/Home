@* Range slider for continuous values (brightness, temperature, volume). Use @bind-Value for two-way binding.
   ValueChanged fires continuously while dragging; ValueCommitted fires once on release, for callers
   that need to avoid hammering a remote service on every pixel of travel. *@

<div class="flex flex-col gap-2 @this.Class">
    @if (!string.IsNullOrEmpty(this.Label))
    {
        <div class="flex justify-between items-center">
            <label class="text-sm font-medium text-ink-300">@this.Label</label>
            <span class="text-sm font-semibold text-lights tabular-nums">@this.Value@this.Unit</span>
        </div>
    }
    <input type="range"
           min="@this.Min"
           max="@this.Max"
           step="@this.Step"
           value="@this.Value"
           disabled="@this.Disabled"
           @oninput="this.OnInputChanged"
           @onchange="this.OnCommitted"
           class="w-full h-2 bg-ink-700 rounded-full appearance-none cursor-pointer disabled:opacity-50" />
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public EventCallback<double> ValueCommitted { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var _Value))
            await this.ValueChanged.InvokeAsync(_Value);
    }

    private async Task OnCommitted(ChangeEventArgs e)
    {
        if (this.ValueCommitted.HasDelegate && double.TryParse(e.Value?.ToString(), out var _Value))
            await this.ValueCommitted.InvokeAsync(_Value);
    }
}
