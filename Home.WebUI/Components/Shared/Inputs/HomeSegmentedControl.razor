@* Segmented control for mutually exclusive option selection. Use @bind-Value for two-way binding. *@
@typeparam TValue

<div class="inline-flex bg-ink-800 rounded-lg p-1 gap-1 @this.Class">
    @foreach (var _Option in this.Options)
    {
        <HomeButton Variant="bare"
                    Size="none"
                    Class="@this.GetOptionClasses(_Option.Value)"
                    OnClick="() => this.SelectAsync(_Option.Value)">
            @_Option.Label
        </HomeButton>
    }
</div>
