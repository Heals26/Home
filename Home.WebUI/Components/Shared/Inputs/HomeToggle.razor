@* iOS-style toggle switch. Use @bind-Value for two-way binding. *@

<HomeButton Variant="bare"
            Size="none"
            role="switch"
            @* Spelled out rather than bound to the bool: Blazor renders false by dropping the
               attribute, and a switch with no aria-checked reads as an ordinary button. *@
            aria-checked="@(this.Value ? "true" : "false")"
            Class="@this.GetClasses()"
            Disabled="this.Disabled"
            OnClick="this.ToggleAsync">
    <span class="@this.GetThumbClasses()"></span>
</HomeButton>
