@* Text input, for text, email, search, url and tel. For passwords use HomePasswordInput. *@

<div class="flex flex-col gap-1.5 @this.Class">
    @if (!string.IsNullOrEmpty(this.Label))
    {
        <label for="@this.m_InputID" class="text-sm font-medium text-ink-300">@this.Label</label>
    }
    @* Keyed on the writes, not on every render: see the code-behind for why the box is left alone
       while someone is typing into it. *@
    <input @attributes="this.AdditionalAttributes"
           @key="this.m_Written"
           @ref="this.m_Input"
           id="@this.m_InputID"
           type="@this.Type"
           name="@this.GetName()"
           autocomplete="@this.AutoComplete"
           inputmode="@this.InputMode"
           spellcheck="@this.GetSpellCheck()"
           autocapitalize="@this.GetAutoCapitalise()"
           value="@this.m_Shown"
           placeholder="@this.Placeholder"
           disabled="@this.Disabled"
           aria-invalid="@(string.IsNullOrEmpty(this.Error) ? null : "true")"
           aria-describedby="@this.GetDescribedBy()"
           @oninput="this.OnInputChanged"
           @onchange="this.OnChanged"
           @onkeydown="this.OnKeyDown"
           @onfocus="this.OnFocus"
           @onblur="this.OnBlur"
           class="@this.GetInputClasses()" />
    @if (!string.IsNullOrEmpty(this.Hint))
    {
        <p id="@this.HintID" class="text-xs text-ink-500">@this.Hint</p>
    }
    @if (!string.IsNullOrEmpty(this.Error))
    {
        <span id="@this.ErrorID" class="text-xs text-red-400">@this.Error</span>
    }
</div>
