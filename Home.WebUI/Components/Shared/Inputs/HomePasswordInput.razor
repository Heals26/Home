@* Password input with show/hide toggle. *@

<div class="flex flex-col gap-1.5 @this.Class">
    @if (!string.IsNullOrEmpty(this.Label))
    {
        <label class="text-sm font-medium text-ink-300">@this.Label</label>
    }
    <div class="relative">
        <input type="@(this.m_ShowPassword ? "text" : "password")"
               value="@this.Value"
               placeholder="@this.Placeholder"
               disabled="@this.Disabled"
               @oninput="this.OnInputChanged"
               class="@this.GetInputClasses()" />
        <button type="button"
                tabindex="-1"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-ink-500 hover:text-ink-300 transition-colors"
                @onclick="this.ToggleVisibility">
            <span class="home-icon @(this.m_ShowPassword ? "home-icon-eye-off" : "home-icon-eye") h-5 w-5 inline-block"></span>
        </button>
    </div>
    @if (!string.IsNullOrEmpty(this.Error))
    {
        <span class="text-xs text-red-400">@this.Error</span>
    }
</div>
