@* Password input with show/hide toggle. *@

<div class="flex flex-col gap-1.5 @this.Class">
    @if (!string.IsNullOrEmpty(this.Label))
    {
        <label for="@this.m_InputID" class="text-sm font-medium text-ink-300">@this.Label</label>
    }
    <div class="relative">
        <input id="@this.m_InputID"
               type="@(this.m_ShowPassword ? "text" : "password")"
               name="@this.Name"
               autocomplete="@this.AutoComplete"
               value="@this.Value"
               placeholder="@this.Placeholder"
               disabled="@this.Disabled"
               aria-invalid="@(string.IsNullOrEmpty(this.Error) ? null : "true")"
               aria-describedby="@(string.IsNullOrEmpty(this.Error) ? null : this.ErrorID)"
               @oninput="this.OnInputChanged"
               class="@this.GetInputClasses()" />
        <button type="button"
                tabindex="-1"
                aria-label="@(this.m_ShowPassword ? "Hide password" : "Show password")"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-ink-500 hover:text-ink-300 transition-colors"
                @onclick="this.ToggleVisibility">
            <span class="home-icon @(this.m_ShowPassword ? "home-icon-eye-off" : "home-icon-eye") h-5 w-5 inline-block"></span>
        </button>
    </div>
    @if (!string.IsNullOrEmpty(this.Error))
    {
        <span id="@this.ErrorID" class="text-xs text-red-400">@this.Error</span>
    }
</div>
