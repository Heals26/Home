@inject Home.WebUI.Infrastructure.Security.AuthorisationService AuthorisationService

@* Renders nothing — exists solely to trigger InitialiseAsync once JS interop
   is available (OnAfterRenderAsync firstRender). Placed outside AuthorizeRouteView
   so it fires while the Authorizing slot is still showing. *@

@code {

    #region Lifecycle Methods

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await this.AuthorisationService.InitialiseAsync();
    }

    #endregion Lifecycle Methods

}
