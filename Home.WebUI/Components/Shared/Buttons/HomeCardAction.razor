@* One cell of the action strip across the foot of a card. Equal width, divided by a rule from the
   cell before it. *@

<HomeButton @attributes="this.AdditionalAttributes"
            Variant="bare"
            Size="none"
            Class="@this.GetClasses()"
            Disabled="this.Disabled"
            OnClick="this.OnClick">
    @this.ChildContent
</HomeButton>
