@* The only <button> in the app. Variants: primary (default), secondary, ghost, link, danger, bare.
   Sizes: sm, md, lg, none. IconOnly makes it a square of that size. Anything shaped differently
   from a button (a row, a chip, a swatch) composes this with Variant="bare". *@

@* Disabled WITH a DisabledReason, the button stays tappable and answers with the reason rather
   than being a silent dead tap. The message hangs off the button itself, so no layout changes. *@

<button type="@this.Type"
        class="@this.GetClasses()"
        disabled="@(this.IsHardDisabled() || this.Loading)"
        @onclick="this.HandleClickAsync"
        @onclick:stopPropagation="this.StopPropagation"
        @onclick:preventDefault="this.PreventDefault"
        @ondragstart="this.OnDragStart"
        @onmousedown:preventDefault="this.KeepFocusOnMouseDown"
        @attributes="this.AdditionalAttributes">
    @if (this.Loading)
    {
        <span class="inline-block h-4 w-4 border-2 border-current border-t-transparent rounded-full animate-spin mr-2"></span>
    }
    @this.ChildContent

    @if (this.m_ShowDisabledReason && this.HasDisabledReason())
    {
        <span role="status"
              class="absolute top-full right-0 mt-1.5 z-30 w-max max-w-[16rem] whitespace-normal text-left rounded-lg border border-ink-700 bg-ink-800 px-3 py-2 text-xs font-normal text-ink-200 shadow-xl">
            @this.DisabledReason
        </span>
    }
</button>
