@* Reusable button. Variants: primary (default), secondary, ghost, danger. Sizes: sm, md, lg (default md). *@

<button type="@this.Type"
        class="@this.GetClasses()"
        disabled="@(this.Disabled || this.Loading)"
        @onclick="@(this.OnClick.HasDelegate ? this.OnClick : EventCallback.Empty)"
        @attributes="this.AdditionalAttributes">
    @if (this.Loading)
    {
        <span class="inline-block h-4 w-4 border-2 border-current border-t-transparent rounded-full animate-spin mr-2"></span>
    }
    @this.ChildContent
</button>
