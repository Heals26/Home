@* A pill that narrows a list. Selected fills, unselected outlines. *@

<HomeButton @attributes="this.AdditionalAttributes"
            aria-pressed="@this.Selected"
            Variant="bare"
            Size="none"
            Class="@this.GetClasses()"
            Disabled="this.Disabled"
            OnClick="this.OnClick">
    @this.ChildContent
</HomeButton>
