@* Surface card with optional title, subtitle and actions slot. *@

<div class="@this.GetClasses()">
    @if (this.Title != null || this.TitleContent != null || this.ActionsContent != null)
    {
        <div class="flex items-center justify-between px-5 py-4 border-b border-ink-800">
            <div>
                @if (this.TitleContent != null)
                {
                    @this.TitleContent
                }
                else if (this.Title != null)
                {
                    <h2 class="text-base font-semibold text-ink-50">@this.Title</h2>
                }
                @if (this.Subtitle != null)
                {
                    <p class="text-sm text-ink-400 mt-0.5">@this.Subtitle</p>
                }
            </div>
            @if (this.ActionsContent != null)
            {
                <div class="flex items-center gap-2">
                    @this.ActionsContent
                </div>
            }
        </div>
    }
    <div class="@(this.Padded ? "p-5" : "")">
        @this.ChildContent
    </div>
</div>
