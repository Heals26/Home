@* Persistent app navigation — a left rail on wide screens, a bottom bar on narrow ones.
   Each pillar owns a hue and the active item wears it, so colour tells the family
   where they are without reading. *@

<nav class="hidden md:flex flex-col w-24 shrink-0 bg-ink-950 border-r border-ink-800/60 pt-5 pb-3">
    <a href="/" class="font-display text-2xl text-ink-50 text-center mb-6 select-none">H.</a>

    <div class="flex-1 flex flex-col gap-1 px-2">
        @foreach (var _Item in m_Items)
        {
            <NavLink href="@_Item.Href"
                     Match="_Item.Match"
                     class="group flex flex-col items-center gap-1 rounded-xl py-2.5 min-h-[56px] text-ink-500 hover:text-ink-200 hover:bg-ink-900/70 transition-colors select-none"
                     ActiveClass="@($"bg-ink-900 {_Item.ActiveText}")">
                <span class="home-icon @_Item.Icon h-6 w-6"></span>
                <span class="text-[11px] font-medium tracking-wide">@_Item.Label</span>
            </NavLink>
        }
    </div>

    <div class="px-2">
        <NavLink href="/settings"
                 class="group flex flex-col items-center gap-1 rounded-xl py-2.5 min-h-[56px] text-ink-500 hover:text-ink-200 hover:bg-ink-900/70 transition-colors select-none"
                 ActiveClass="bg-ink-900 text-household">
            <span class="home-icon home-icon-cog h-6 w-6"></span>
            <span class="text-[11px] font-medium tracking-wide">Settings</span>
        </NavLink>
    </div>
</nav>

<nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-ink-950/95 backdrop-blur border-t border-ink-800/60 pb-[env(safe-area-inset-bottom)]">
    <div class="grid grid-cols-7">
        @foreach (var _Item in m_Items)
        {
            <NavLink href="@_Item.Href"
                     Match="_Item.Match"
                     class="flex flex-col items-center gap-0.5 py-2.5 min-h-[60px] text-ink-500 transition-colors select-none"
                     ActiveClass="@_Item.ActiveText">
                <span class="home-icon @_Item.Icon h-6 w-6"></span>
                <span class="text-[10px] font-medium">@_Item.Label</span>
            </NavLink>
        }
        <NavLink href="/settings"
                 class="flex flex-col items-center gap-0.5 py-2.5 min-h-[60px] text-ink-500 transition-colors select-none"
                 ActiveClass="text-household">
            <span class="home-icon home-icon-cog h-6 w-6"></span>
            <span class="text-[10px] font-medium">Settings</span>
        </NavLink>
    </div>
</nav>

