@inherits LayoutComponentBase

<div class="flex app-viewport bg-ink-950">
    <AuthorizeView>
        <Authorized>
            <HomeNavRail />
        </Authorized>
    </AuthorizeView>

    @* The bottom bar is fixed, so main reserves its height — plus the home-indicator inset —
       under exactly the same condition that shows it. *@
    <main class="flex-1 min-w-0 app-scrollable pb-[calc(5rem_+_env(safe-area-inset-bottom))] rail:pb-0">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="p-6 text-red-400">
                    <p class="font-semibold">Something went wrong</p>
                    <p class="text-sm text-ink-400 mt-1">@ex.Message</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>
