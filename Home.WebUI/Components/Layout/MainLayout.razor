@inherits LayoutComponentBase

<div class="flex h-screen bg-ink-950">
    <AuthorizeView>
        <Authorized>
            <HomeNavRail />
        </Authorized>
    </AuthorizeView>

    <main class="flex-1 min-w-0 app-scrollable pb-20 md:pb-0">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="p-6 text-red-400">
                    <p class="font-semibold">Something went wrong</p>
                    <p class="text-sm text-ink-400 mt-1">@ex.Message</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>
