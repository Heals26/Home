@using Home.WebUI.Infrastructure.Services.Security

@attribute [AllowAnonymous]

@page "/setup"

@inject IOAuthClient OAuthClient

<HomePageTitle Title="Set up your household" />

<div class="min-h-screen bg-ink-950 flex items-center justify-center p-4 app-scrollable">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <h1 class="font-display text-5xl text-ink-50">Home</h1>
            <p class="text-sm text-ink-400 mt-2">Set up your household</p>
        </div>

        <div class="bg-ink-900 rounded-2xl border border-ink-800 p-6">
            @* A statically rendered Blazor form, like the login page — registering signs the
               first member straight in, and signing in writes a cookie (see App.razor.cs). *@
            <form method="post" @formname="setup" @onsubmit="this.RegisterAsync">
                <AntiforgeryToken />
                <div class="flex flex-col gap-4">
                    <HomeTextInput Label="Household name"
                                   Name="HouseholdName"
                                   AutoComplete="off"
                                   Value="@(this.HouseholdName ?? string.Empty)"
                                   Placeholder="e.g. The Healys" />

                    <div class="grid grid-cols-2 gap-3">
                        <HomeTextInput Label="First name"
                                       Name="FirstName"
                                       AutoComplete="given-name"
                                       Value="@(this.FirstName ?? string.Empty)" />
                        <HomeTextInput Label="Last name"
                                       Name="LastName"
                                       AutoComplete="family-name"
                                       Value="@(this.LastName ?? string.Empty)" />
                    </div>

                    <HomeTextInput Label="Email"
                                   Type="email"
                                   Name="Email"
                                   AutoComplete="email"
                                   Value="@(this.Email ?? string.Empty)"
                                   Placeholder="You'll sign in with this" />

                    <HomePasswordInput Label="Password"
                                       Name="Password"
                                       AutoComplete="new-password" />

                    @if (!string.IsNullOrEmpty(this.m_Error))
                    {
                        <p role="alert" class="text-sm text-red-400">@this.m_Error</p>
                    }

                    <HomeButton Type="submit" Class="w-full mt-2">Create household</HomeButton>

                    <p class="text-xs text-ink-500 text-center">
                        This creates the household and its first member — everyone else joins from inside the app.
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>
