@using Home.WebUI.Infrastructure.Services.Security

@attribute [AllowAnonymous]

@page "/login"

@inject ILoginThrottle LoginThrottle
@inject IOAuthClient OAuthClient

<HomePageTitle Title="Sign in" />

<div class="min-h-screen bg-ink-950 flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <h1 class="font-display text-5xl text-ink-50">Home</h1>
            <p class="text-sm text-ink-400 mt-2">Sign in to your household</p>
        </div>

        <div class="bg-ink-900 rounded-2xl border border-ink-800 p-6">
            @* A statically rendered Blazor form: signing in answers with Set-Cookie, and only an
               HTTP response can carry one — which is why this page renders without a circuit
               (see App.razor.cs). *@
            <form method="post" @formname="sign-in" @onsubmit="this.SignInAsync">
                <AntiforgeryToken />
                <div class="flex flex-col gap-4">
                    <HomeTextInput Label="Username"
                                   Name="Username"
                                   AutoComplete="username"
                                   Value="@(this.Username ?? string.Empty)"
                                   Placeholder="Enter your username" />

                    <HomePasswordInput Label="Password"
                                       Name="Password"
                                       AutoComplete="current-password"
                                       Placeholder="Enter your password" />

                    @if (!string.IsNullOrEmpty(this.m_Error))
                    {
                        <p role="alert" class="text-sm text-red-400">@this.m_Error</p>
                    }

                    <HomeButton Type="submit" Class="w-full mt-2">Sign in</HomeButton>
                </div>
            </form>
        </div>

        @if (this.m_RequiresSetup)
        {
            <p class="text-sm text-ink-400 text-center mt-6">
                First time here?
                <a href="/setup" class="text-ink-50 underline underline-offset-4 hover:text-white">Set up your household</a>
            </p>
        }
    </div>
</div>
