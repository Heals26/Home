@using Home.WebUI.Infrastructure.Services.Security

@attribute [AllowAnonymous]

@page "/login"

@inject IAuthorisationService AuthorisationService

<HomePageTitle Title="Sign in" />

<div class="min-h-screen bg-ink-950 flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <h1 class="font-display text-5xl text-ink-50">Home</h1>
            <p class="text-sm text-ink-400 mt-2">Sign in to your household</p>
        </div>

        <div class="bg-ink-900 rounded-2xl border border-ink-800 p-6">
            <EditForm Model="this.m_Model" OnValidSubmit="this.HandleSubmitAsync">
                <div class="flex flex-col gap-4">
                    <HomeTextInput Label="Username"
                                   Name="username"
                                   AutoComplete="username"
                                   @bind-Value="this.m_Model.Username"
                                   Placeholder="Enter your username" />

                    <HomePasswordInput Label="Password"
                                       Name="password"
                                       AutoComplete="current-password"
                                       @bind-Value="this.m_Model.Password"
                                       Placeholder="Enter your password" />

                    <HomeButton Type="submit" Loading="this.m_IsLoading" Class="w-full mt-2">
                        Sign in
                    </HomeButton>
                </div>
            </EditForm>
        </div>

        @if (this.m_RequiresSetup)
        {
            <p class="text-sm text-ink-400 text-center mt-6">
                First time here?
                <a href="/setup" class="text-ink-50 underline underline-offset-4 hover:text-white">Set up your household</a>
            </p>
        }

        <ErrorHandler @ref="this.m_ErrorHandler" />
    </div>
</div>
