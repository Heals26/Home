@attribute [AllowAnonymous]

@page "/logout"

<HomePageTitle Title="Sign out" />

<div class="min-h-screen bg-ink-950 flex items-center justify-center p-4">
    <div class="w-full max-w-sm text-center">
        <h1 class="font-display text-4xl text-ink-50">Sign out?</h1>
        <p class="text-sm text-ink-400 mt-2">
            This device will need the household password again to get back in.
        </p>

        <div class="bg-ink-900 rounded-2xl border border-ink-800 p-6 mt-6">
            @* A statically rendered Blazor form: signing out clears the cookie, and only an HTTP
               response can do that (see App.razor.cs). *@
            <form method="post" @formname="sign-out" @onsubmit="this.SignOutAsync">
                <AntiforgeryToken />
                <HomeButton Type="submit" Variant="danger" Class="w-full">Sign out</HomeButton>
            </form>
            @* An anchor, not a HomeButton — this page has no circuit, so only real navigation works. *@
            <a href="/" class="mt-3 inline-flex w-full min-h-[48px] items-center justify-center rounded-lg px-4 py-3 text-sm font-medium text-ink-400 transition-all hover:bg-ink-800 hover:text-ink-50">
                Stay signed in
            </a>
        </div>
    </div>
</div>
