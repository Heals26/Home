@page "/settings"

<HomePageTitle Title="Settings" />

<div class="flex flex-col h-full max-w-2xl mx-auto w-full">
    <HomeTopBar Title="Settings" Eyebrow="This household" EyebrowClass="text-household" />

    <div class="flex-1 px-6 pb-6 app-scrollable">
        @if (this.m_Settings == null)
        {
            <HomeLoader Class="py-16" />
        }
        else
        {
            <div class="flex flex-col gap-6">

                <HomeCard Title="Household" Subtitle="How this home shows up around the app.">
                    <ChildContent>
                        <div class="flex flex-col gap-4">
                            <HomeTextInput Label="Name" Name="household-name" AutoComplete="off" Placeholder="e.g. The Healys" @bind-Value="this.m_Name" />
                            <div class="flex items-center justify-end gap-3">
                                @if (this.m_HouseholdSaved)
                                {
                                    <span class="text-sm text-shopping">Saved</span>
                                }
                                <HomeButton OnClick="this.SaveHouseholdAsync"
                                            Loading="this.m_SavingHousehold"
                                            Disabled="@string.IsNullOrWhiteSpace(this.m_Name)">Save</HomeButton>
                            </div>
                        </div>
                    </ChildContent>
                </HomeCard>

                <HomeCard Title="Members" Subtitle="Everyone who can sign in to this household.">
                    <ChildContent>
                        <div class="flex flex-col gap-3">
                            @if (this.m_Users == null)
                            {
                                <HomeLoader Class="py-4" />
                            }
                            else
                            {
                                @* Tap the person to edit them, the same rule the recipe and shopping
                                   rows follow. *@
                                <div class="divide-y divide-ink-800 -mx-5">
                                    @foreach (var _User in this.m_Users)
                                    {
                                        <button type="button"
                                                class="w-full flex items-center gap-3 px-5 py-2.5 min-h-[56px] text-left hover:bg-ink-800/50 active:bg-ink-800 transition-colors"
                                                aria-label="@($"Edit {_User.FullName}")"
                                                @onclick="() => this.OpenEditMemberModal(_User)">
                                            <span class="h-9 w-9 shrink-0 rounded-full bg-ink-800 text-ink-300 text-xs font-semibold flex items-center justify-center">@Initials(_User.FullName)</span>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm font-medium text-ink-50 truncate">@_User.FullName</p>
                                                <p class="text-xs text-ink-500 truncate">@_User.Email</p>
                                            </div>
                                            @if (this.IsSignedInMember(_User))
                                            {
                                                <span class="shrink-0 rounded-full border border-ink-700 px-2.5 py-0.5 text-xs text-ink-400">You</span>
                                            }
                                        </button>
                                    }
                                </div>
                                <div class="flex justify-end">
                                    <HomeButton Size="sm" Variant="secondary" OnClick="this.OpenAddMemberModal">Add member</HomeButton>
                                </div>
                            }
                        </div>
                    </ChildContent>
                </HomeCard>

                <HomeCard Title="Location" Subtitle="Sets where sunrise and sunset happen for this home, so light schedules can follow the sun.">
                    <ChildContent>
                        <div class="flex flex-col gap-4">
                            <div class="grid grid-cols-2 gap-3">
                                <div class="flex flex-col gap-1.5">
                                    <label for="settings-latitude" class="text-sm font-medium text-ink-300">Latitude</label>
                                    <input id="settings-latitude" type="number" step="any" min="-90" max="90"
                                           name="latitude" autocomplete="off" inputmode="decimal"
                                           class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px]"
                                           @bind="this.m_Latitude" />
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <label for="settings-longitude" class="text-sm font-medium text-ink-300">Longitude</label>
                                    <input id="settings-longitude" type="number" step="any" min="-180" max="180"
                                           name="longitude" autocomplete="off" inputmode="decimal"
                                           class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px]"
                                           @bind="this.m_Longitude" />
                                </div>
                            </div>
                            <p class="text-xs text-ink-500">
                                Decimal degrees, with south and west negative. Brisbane is roughly -27.47, 153.03.
                            </p>
                            <div class="flex items-center justify-end gap-3">
                                @if (this.m_LocationSaved)
                                {
                                    <span class="text-sm text-shopping">Saved</span>
                                }
                                <HomeButton OnClick="this.SaveLocationAsync" Loading="this.m_SavingLocation">Save</HomeButton>
                            </div>
                        </div>
                    </ChildContent>
                </HomeCard>

                <HomeCard Title="Connections" Subtitle="Services this home is linked to.">
                    <ChildContent>
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center gap-3">
                                <span class="home-icon home-icon-lightbulb h-5 w-5 text-lights"></span>
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-ink-50">LIFX</p>
                                    <p class="text-xs @(this.m_Settings.HasLifxApiToken ? "text-shopping" : "text-ink-500")">
                                        @(this.m_Settings.HasLifxApiToken ? "Connected" : "Not connected")
                                    </p>
                                </div>
                                @if (this.m_Settings.HasLifxApiToken)
                                {
                                    <HomeButton Size="sm" Variant="ghost" OnClick="this.DisconnectLifxAsync" Loading="this.m_SavingConnection">
                                        Disconnect
                                    </HomeButton>
                                }
                            </div>

                            <HomePasswordInput Label="@(this.m_Settings.HasLifxApiToken ? "Replace token" : "API token")"
                                               Name="lifx-api-token"
                                               AutoComplete="new-password"
                                               Placeholder="Paste a token from cloud.lifx.com/settings"
                                               @bind-Value="this.m_LifxToken" />
                            <p class="text-xs text-ink-500">
                                The token is stored with this household's settings and never shown again.
                            </p>
                            <div class="flex items-center justify-end gap-3">
                                @if (this.m_ConnectionSaved)
                                {
                                    <span class="text-sm text-shopping">Saved</span>
                                }
                                <HomeButton OnClick="this.SaveLifxTokenAsync"
                                            Loading="this.m_SavingConnection"
                                            Disabled="@string.IsNullOrWhiteSpace(this.m_LifxToken)">
                                    @(this.m_Settings.HasLifxApiToken ? "Replace" : "Connect")
                                </HomeButton>
                            </div>
                        </div>
                    </ChildContent>
                </HomeCard>

                <HomeCard Title="Appearance" Subtitle="Applies to this device only. Every other screen keeps its own choice.">
                    <ChildContent>
                        <div class="flex flex-col gap-3">
                            <HomeThemeToggle />
                            <p class="text-xs text-ink-500">
                                Dark is the default, and stays the default on any device that hasn't chosen.
                            </p>
                        </div>
                    </ChildContent>
                </HomeCard>

                @* Sessions are 90 days and sliding, so this list is the only way to end one from
                   somewhere else. The current device is shown but cannot be signed out from here:
                   the browser would keep a cookie for a session that no longer exists. *@
                <HomeCard Title="Devices" Subtitle="Where this household is signed in.">
                    <ChildContent>
                        <div class="flex flex-col gap-3">
                            @if (this.m_Devices == null)
                            {
                                <HomeLoader Class="py-4" />
                            }
                            else if (this.m_Devices.Count == 0)
                            {
                                <p class="text-sm text-ink-500 py-2">Nothing is signed in, which cannot be right if you are reading this.</p>
                            }
                            else
                            {
                                <div class="divide-y divide-ink-800 -mx-5">
                                    @foreach (var _Device in this.VisibleDevices())
                                    {
                                        <div class="flex items-center gap-3 px-5 py-2.5 min-h-[56px]">
                                            @* Both class names are written out, never assembled: a
                                               name Tailwind cannot find in the source gets purged
                                               and the icon renders as a grey square. *@
                                            <span class="home-icon home-icon-device h-5 w-5 shrink-0 @(_Device.IsCurrentDevice ? "text-ink-50" : "text-ink-500")"></span>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm font-medium text-ink-50 truncate">@_Device.Name</p>
                                                <p class="text-xs text-ink-500 truncate">@this.DescribeWhen(_Device.LastUsedOnUTC)</p>
                                            </div>
                                            @if (_Device.IsCurrentDevice)
                                            {
                                                <span class="shrink-0 rounded-full border border-ink-700 px-2.5 py-0.5 text-xs text-ink-400">This device</span>
                                            }
                                            else
                                            {
                                                <HomeButton Size="sm"
                                                            Variant="secondary"
                                                            Disabled="this.m_SigningOutDeviceID != null"
                                                            OnClick="() => this.SignOutDeviceAsync(_Device)">Sign out</HomeButton>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (!this.m_ShowAllDevices && this.HiddenDeviceCount() > 0)
                                {
                                    <button type="button"
                                            class="text-sm text-ink-400 hover:text-ink-50 underline underline-offset-4 self-start min-h-[44px]"
                                            @onclick="() => this.m_ShowAllDevices = true">
                                        Show @this.HiddenDeviceCount() more
                                    </button>
                                }

                                @* The explanation only earns its place next to a control that needs
                                   it. On the last remaining device there is nothing to sign out, so
                                   the whole footer goes rather than sitting there unactionable. *@
                                @if (this.OtherDeviceCount() > 0)
                                {
                                    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink-800 pt-4">
                                        <p class="text-sm text-ink-400">
                                            Signing a device out means it has to sign in again next time it is used.
                                        </p>
                                        <HomeButton Size="sm"
                                                    Variant="secondary"
                                                    Disabled="this.m_SigningOutOthers"
                                                    OnClick="this.SignOutOtherDevicesAsync">@this.SignOutOthersLabel()</HomeButton>
                                    </div>
                                }
                            }
                        </div>
                    </ChildContent>
                </HomeCard>

                <HomeCard Title="Account">
                    <ChildContent>
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center justify-between gap-3">
                                <p class="text-sm text-ink-400">Change the password you sign in with.</p>
                                <HomeButton Variant="secondary" OnClick="this.OpenChangePasswordModal">Change password</HomeButton>
                            </div>
                            <div class="flex items-center justify-between gap-3 border-t border-ink-800 pt-4">
                                <p class="text-sm text-ink-400">Signing out returns this tablet to the login screen.</p>
                                <HomeButton Variant="secondary" OnClick="this.SignOut">Sign out</HomeButton>
                            </div>
                        </div>
                    </ChildContent>
                </HomeCard>

            </div>
        }
    </div>
</div>

@* Edit-member modal. Removing lives in here rather than on the row, and is refused for whoever is
   signed in, because locking yourself out of your own household is not an undoable mistake. *@
<HomeModal @bind-Visible="this.m_ShowEditMember" Title="Edit member" OnSubmit="this.SaveMemberAsync">
    <ChildContent>
        <div class="flex flex-col gap-4">
            <div class="grid grid-cols-2 gap-3">
                <HomeTextInput Label="First name"
                               Name="given-name"
                               AutoComplete="off"
                               @bind-Value="this.m_MemberFirstName" />
                <HomeTextInput Label="Last name"
                               Name="family-name"
                               AutoComplete="off"
                               @bind-Value="this.m_MemberLastName" />
            </div>
            <HomeTextInput Label="Email"
                           Type="email"
                           Name="email"
                           AutoComplete="off"
                           @bind-Value="this.m_MemberEmail" />
            <div class="flex items-center gap-3">
                @if (!this.m_EditingSelf)
                {
                    <HomeButton Variant="ghost"
                                Class="text-red-400 hover:text-red-300 hover:bg-red-950/40"
                                Loading="this.m_RemovingMember"
                                OnClick="this.RemoveMemberAsync">
                        <span class="home-icon home-icon-trash h-4 w-4 mr-1 inline-block"></span>
                        Remove
                    </HomeButton>
                }
                <div class="flex-1"></div>
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowEditMember = false">Cancel</HomeButton>
                <HomeButton Loading="this.m_SavingMember"
                            Disabled="@(!this.CanSaveMember())"
                            OnClick="this.SaveMemberAsync">Save</HomeButton>
            </div>
            @if (this.m_EditingSelf)
            {
                <p class="text-xs text-ink-500">This is you. Change your own password from the Account card below.</p>
            }
        </div>
    </ChildContent>
</HomeModal>

@* Change-password modal *@
<HomeModal @bind-Visible="this.m_ShowChangePassword" Title="Change your password" OnSubmit="this.ChangePasswordAsync">
    <ChildContent>
        <div class="flex flex-col gap-4">
            <HomePasswordInput Label="New password"
                               Name="new-password"
                               AutoComplete="new-password"
                               @bind-Value="this.m_NewPassword" />
            <HomePasswordInput Label="Confirm new password"
                               Name="new-password"
                               AutoComplete="new-password"
                               @bind-Value="this.m_ConfirmPassword" />
            @if (this.PasswordProblem() is { Length: > 0 } _Problem)
            {
                <p class="text-sm text-red-400">@_Problem</p>
            }
            <p class="text-xs text-ink-500">
                Other devices stay signed in. Changing the password does not end sessions that are already running.
            </p>
            <div class="flex justify-end gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowChangePassword = false">Cancel</HomeButton>
                <HomeButton Loading="this.m_ChangingPassword"
                            Disabled="@(this.PasswordProblem().Length > 0 || this.m_NewPassword.Length == 0 || this.m_ConfirmPassword.Length == 0)"
                            OnClick="this.ChangePasswordAsync">Change password</HomeButton>
            </div>
        </div>
    </ChildContent>
</HomeModal>

@* Add-member modal *@
<HomeModal @bind-Visible="this.m_ShowAddMember" Title="Add a member" OnSubmit="this.AddMemberAsync">
    <ChildContent>
        <div class="flex flex-col gap-4">
            <div class="grid grid-cols-2 gap-3">
                <HomeTextInput Label="First name"
                               Name="given-name"
                               AutoComplete="given-name"
                               @bind-Value="this.m_MemberFirstName" />
                <HomeTextInput Label="Last name"
                               Name="family-name"
                               AutoComplete="family-name"
                               @bind-Value="this.m_MemberLastName" />
            </div>
            <HomeTextInput Label="Email"
                           Type="email"
                           Name="email"
                           AutoComplete="email"
                           @bind-Value="this.m_MemberEmail"
                           Placeholder="They'll sign in with this" />
            <HomePasswordInput Label="Password"
                               Name="new-password"
                               AutoComplete="new-password"
                               @bind-Value="this.m_MemberPassword" />
            <div class="flex justify-end gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowAddMember = false">Cancel</HomeButton>
                <HomeButton Loading="this.m_AddingMember"
                            Disabled="@(!this.CanAddMember())"
                            OnClick="this.AddMemberAsync">Add member</HomeButton>
            </div>
        </div>
    </ChildContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
