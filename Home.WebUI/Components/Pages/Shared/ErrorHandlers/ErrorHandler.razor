@if (this.m_Errors.Any())
{
    <div class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full">
        @foreach (var _Error in this.m_Errors)
        {
            <div class="bg-ink-900 border border-ink-700 rounded-xl px-4 py-3 text-sm shadow-lg flex gap-3 items-start">
                <div class="flex-1 min-w-0">
                    @if (!string.IsNullOrWhiteSpace(_Error.Title))
                    {
                        <p class="font-semibold text-red-400">@_Error.Title</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_Error.Detail))
                    {
                        <p class="text-ink-300 text-xs mt-0.5">@_Error.Detail</p>
                    }
                    @foreach (var _FieldError in _Error.FieldErrors)
                    {
                        <p class="text-red-300 text-xs mt-0.5">@_FieldError</p>
                    }
                </div>
                <button @onclick="() => this.RemoveError(_Error)"
                        class="text-ink-500 hover:text-ink-200 shrink-0 mt-0.5"
                        type="button">
                    <span class="home-icon home-icon-x h-4 w-4 inline-block"></span>
                </button>
            </div>
        }
    </div>
}
