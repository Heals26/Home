@page "/recipes"

<CascadingValue Value="this.m_CancellationTokenHandler.Token" Name="CancellationToken">
    <div class="flex flex-col h-full">
        <HomeTopBar Title="Recipes" Eyebrow="The book" EyebrowClass="text-recipes">
            <ActionsContent>
                <HomeButton Size="sm" OnClick="this.OpenCreateModal">
                    <span class="home-icon home-icon-plus h-4 w-4 mr-1 inline-block"></span>
                    Add recipe
                </HomeButton>
            </ActionsContent>
        </HomeTopBar>

        <div class="flex-1 px-6 pb-6 app-scrollable">
            @if (this.m_Recipes == null)
            {
                <HomeLoader Class="py-16" />
            }
            else if (!this.m_Recipes.Recipes.Any())
            {
                <HomeEmptyState Title="No recipes yet" Subtitle="Add your first recipe to get the book started">
                    <ActionContent>
                        <HomeButton OnClick="this.OpenCreateModal">Add recipe</HomeButton>
                    </ActionContent>
                </HomeEmptyState>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
                    @foreach (var _Recipe in this.m_Recipes.Recipes.OrderBy(r => r.Name))
                    {
                        <div class="group relative bg-ink-900 hover:bg-ink-800 border border-ink-800 hover:border-ink-700 rounded-xl p-5 transition-all cursor-pointer"
                             @onclick="() => this.OpenRecipe(_Recipe.RecipeID)">
                            <div class="flex items-start gap-3">
                                <span class="home-icon home-icon-book h-6 w-6 inline-block text-recipes shrink-0 mt-0.5"></span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-semibold text-ink-50 truncate">@_Recipe.Name</p>
                                    @if (!string.IsNullOrWhiteSpace(_Recipe.Url))
                                    {
                                        <p class="text-xs text-ink-500 truncate mt-0.5">@_Recipe.Url</p>
                                    }
                                </div>
                            </div>
                            <button class="absolute top-3 right-3 text-ink-600 hover:text-red-400 transition-colors opacity-0 group-hover:opacity-100"
                                    type="button"
                                    title="Delete recipe"
                                    @onclick="() => this.DeleteRecipeAsync(_Recipe.RecipeID)"
                                    @onclick:stopPropagation="true">
                                <span class="home-icon home-icon-trash h-4 w-4 inline-block"></span>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</CascadingValue>

<HomeModal @bind-Visible="this.m_ShowCreate" Title="New recipe">
    <ChildContent>
        <div class="mb-4 pb-4 border-b border-ink-800">
            <HomeTextInput Label="Import from a web page"
                           Type="url"
                           AutoComplete="off"
                           @bind-Value="this.m_ImportUrl"
                           Placeholder="Paste a recipe URL" />
            <p class="text-xs text-ink-500 mt-1.5">Reads the name, ingredients and steps straight from the site.</p>
            <div class="mt-3 flex justify-end">
                <HomeButton Loading="this.m_Importing"
                            Disabled="@string.IsNullOrWhiteSpace(this.m_ImportUrl)"
                            OnClick="this.ImportRecipeAsync">Import</HomeButton>
            </div>
        </div>

        <EditForm Model="this.m_CreateRequest" OnValidSubmit="this.CreateRecipeAsync">
            <HomeTextInput Label="Recipe name"
                           AutoComplete="off"
                           @bind-Value="this.m_CreateRequest!.Name"
                           Placeholder="e.g. Spaghetti Bolognese" />
            <div class="mt-3">
                <HomeTextInput Label="Source URL (optional)"
                               Type="url"
                               AutoComplete="off"
                               @bind-Value="this.m_CreateRequest!.Url"
                               Placeholder="https://..." />
            </div>
            <div class="mt-4 flex justify-end gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowCreate = false">Cancel</HomeButton>
                <HomeButton Type="submit" Loading="this.m_Creating">Add recipe</HomeButton>
            </div>
        </EditForm>
    </ChildContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
