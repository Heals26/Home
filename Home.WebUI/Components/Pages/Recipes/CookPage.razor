@page "/recipes/{RecipeID:long}/cook"

@using Home.WebUI.Components.Shared.Content

@inject IJSRuntime JS

<HomePageTitle Title="@(this.m_Recipe == null ? "Cooking" : $"Cooking {this.m_Recipe.Name}")" />

@* Cooking mode: one step at a time in big type, giant wet-finger targets, and timers on tap,
   both the ones read out of the step text and any the cook starts. The screen is held
   awake while the page is open. *@

<div class="flex flex-col h-full max-w-3xl mx-auto w-full">
    <HomeTopBar Title="@(this.m_Recipe?.Name ?? "Cooking")"
                Eyebrow="Cooking"
                EyebrowClass="text-recipes"
                ShowBack="true"
                BackHref="@($"/recipes/{this.RecipeID}")">
        <ActionsContent>
            <HomeButton Size="sm" Variant="secondary" OnClick="this.OpenTimerPicker">
                <HomeIcon Name="clock" Class="mr-1" />
                Timer
            </HomeButton>
        </ActionsContent>
    </HomeTopBar>

    <div class="flex-1 min-h-0 px-6 pb-6 flex flex-col">
        @if (this.m_Recipe == null)
        {
            <HomeLoader Class="py-16" />
        }
        else
        {
            @* Active timers stay visible whatever step is showing. *@
            @if (this.m_Timers.Count > 0)
            {
                <div class="flex flex-wrap gap-2 mb-4">
                    @foreach (var _Timer in this.m_Timers)
                    {
                        <HomeChip Class="@(_Timer.IsFinished ? "border-recipes bg-recipes/20 text-recipes animate-pulse font-semibold" : "font-semibold")"
                                  aria-label="@($"Dismiss {_Timer.Label} timer")"
                                  OnClick="() => this.DismissTimer(_Timer)">
                            <HomeIcon Name="clock" />
                            @(_Timer.IsFinished ? $"{_Timer.Label} is done!" : $"{_Timer.Label} · {this.Remaining(_Timer)}")
                        </HomeChip>
                    }
                </div>
            }

            <p class="text-xs font-semibold uppercase tracking-widest text-ink-500 mb-3">
                @this.StepLabel()
            </p>

            @* select-none and tabindex="-1" keep a text caret out of the cooking card: browsers make
               scroll containers keyboard-focusable, and a focused, selectable box shows an I-beam. *@
            <div tabindex="-1"
                 class="flex-1 min-h-0 app-scrollable select-none cursor-default focus:outline-none bg-ink-900 border border-ink-800 rounded-2xl p-6 md:p-8">
                @if (this.OnIngredients())
                {
                    <h2 class="font-display text-3xl text-ink-50 mb-5">Everything you'll need</h2>
                    <ul class="flex flex-col gap-3">
                        @foreach (var _Ingredient in this.m_Recipe.Ingredients)
                        {
                            @* Amount first, matching the recipe page, because mid-cook you are looking for
                               how much, and the name is what you already know you need. *@
                            <li class="flex items-baseline gap-3 text-xl text-ink-100">
                                <span class="h-2 w-2 rounded-full bg-recipes shrink-0 translate-y-[-2px]"></span>
                                @if (RecipeDisplayLogic.DescribeAmount(_Ingredient) is { Length: > 0 } _Amount)
                                {
                                    <span class="shrink-0 text-ink-400 tabular-nums">@_Amount</span>
                                }
                                <span>@_Ingredient.Name</span>
                            </li>
                        }
                    </ul>
                }
                else if (this.CurrentStep() is { } _Step)
                {
                    @if (!string.IsNullOrWhiteSpace(_Step.Title))
                    {
                        <h2 class="font-display text-3xl text-ink-50 mb-4">@_Step.Title</h2>
                    }
                    <HomeMarkdown Content="@_Step.Content" Size="lg" />

                    @if (this.CurrentStepDurations().Any())
                    {
                        <div class="flex flex-wrap gap-2 mt-6">
                            @foreach (var _Minutes in this.CurrentStepDurations())
                            {
                                <HomeButton Size="sm" Variant="secondary" OnClick="() => this.StartTimer(_Minutes)">
                                    <HomeIcon Name="clock" Class="mr-1" />
                                    Start @FormatMinutes(_Minutes) timer
                                </HomeButton>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-xl text-ink-400">
                        This recipe hasn't got any ingredients or steps written down yet.
                    </p>
                }
            </div>

            @* A recipe with ingredients but no steps is a single page: a pair of buttons where one
               is permanently dead reads as broken, so it becomes one honest action. *@
            @if (this.TotalPages() <= 1)
            {
                <div class="mt-4 shrink-0">
                    <HomeButton Size="lg" Class="w-full" OnClick="this.LeaveCooking">
                        Done
                    </HomeButton>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 gap-3 mt-4 shrink-0">
                    @if (this.m_StepIndex == 0)
                    {
                        <HomeButton Variant="secondary" Size="lg" OnClick="this.LeaveCooking">
                            <HomeIcon Name="chevron-left" Size="lg" Class="mr-1" />
                            Leave cooking
                        </HomeButton>
                    }
                    else
                    {
                        <HomeButton Variant="secondary" Size="lg" OnClick="() => this.m_StepIndex--">
                            <HomeIcon Name="chevron-left" Size="lg" Class="mr-1" />
                            Back
                        </HomeButton>
                    }

                    @if (this.IsLastStep())
                    {
                        <HomeButton Size="lg" OnClick="this.LeaveCooking">
                            Done
                        </HomeButton>
                    }
                    else
                    {
                        <HomeButton Size="lg" OnClick="() => this.m_StepIndex++">
                            Next
                            <HomeIcon Name="chevron-right" Size="lg" Class="ml-1" />
                        </HomeButton>
                    }
                </div>
            }
        }
    </div>
</div>

@* Timers can always be started, whether or not the recipe's wording happens to mention a duration. *@
<HomeModal @bind-Visible="this.m_ShowTimerPicker" Title="Start a timer" OnSubmit="this.StartCustomTimer">
    <ChildContent>
        <div class="flex flex-col gap-5">
            <div class="grid grid-cols-3 gap-2">
                @foreach (var _Minutes in s_TimerPresets)
                {
                    <HomeButton Variant="bare"
                                Size="none"
                                Class="min-h-[56px] rounded-xl border border-ink-700 bg-ink-800 text-base font-semibold text-ink-50 enabled:hover:border-recipes/60 enabled:active:scale-95"
                                OnClick="() => this.StartPresetTimer(_Minutes)">
                        @FormatMinutes(_Minutes)
                    </HomeButton>
                }
            </div>

            <div class="flex items-end gap-2">
                <div class="flex-1 min-w-0">
                    <HomeTextInput Label="Or your own number of minutes"
                                   AutoComplete="off"
                                   InputMode="numeric"
                                   Placeholder="e.g. 12"
                                   @bind-Value="this.m_CustomTimerMinutes" />
                </div>
                <HomeButton Size="lg"
                            OnClick="this.StartCustomTimer"
                            Disabled="@(!this.CanStartCustomTimer())"
                            DisabledReason="Type a whole number of minutes between 1 and 1440.">
                    Start
                </HomeButton>
            </div>
        </div>
    </ChildContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
