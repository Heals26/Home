@* One bulb: power, brightness, colour, and in edit mode the group it belongs to. *@

<div class="bg-zinc-900 border border-zinc-800 rounded-xl p-4">
    <div class="flex items-center gap-3">
        <span class="h-10 w-10 rounded-full shrink-0 border border-zinc-700"
              style="background: @ColourPreset.SwatchFor(this.Light.IsConnected, this.Light.IsOn, this.Light.Brightness, this.Light.Hue, this.Light.Saturation)"></span>

        <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-zinc-50 truncate">@this.Light.Label</p>
            <p class="text-xs text-zinc-500">@this.StatusText()</p>
        </div>

        @if (!this.EditMode)
        {
            <HomeToggle Value="this.Light.IsOn"
                        Disabled="!this.Light.IsConnected"
                        ValueChanged="on => this.OnPowerChanged.InvokeAsync(on)" />
        }
    </div>

    @if (this.EditMode)
    {
        <div class="mt-3 pt-3 border-t border-zinc-800">
            <label class="text-xs font-medium text-zinc-400 block mb-1">Group</label>
            <select class="w-full"
                    value="@this.GroupID"
                    @onchange="this.OnGroupSelected">
                @foreach (var _Group in this.Groups)
                {
                    <option value="@_Group.LightGroupID">@_Group.Name</option>
                }
            </select>
        </div>
    }
    else if (this.Light.IsConnected && this.Light.IsOn)
    {
        <div class="mt-4 pt-4 border-t border-zinc-800 flex flex-col gap-4">
            <HomeSlider Label="Brightness"
                        Unit="%"
                        Min="1"
                        Max="100"
                        Value="Percent(this.Light.Brightness)"
                        ValueChanged="v => this.Light.Brightness = v / 100d"
                        ValueCommitted="v => this.OnBrightnessCommitted.InvokeAsync(v / 100d)" />

            <div>
                <p class="text-sm font-medium text-zinc-300 mb-2">Colour</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var _Preset in ColourPreset.All)
                    {
                        <button type="button"
                                title="@_Preset.Name"
                                aria-label="@_Preset.Name"
                                class="h-11 w-11 rounded-lg border border-zinc-700 hover:border-zinc-500 active:scale-95 transition-all"
                                style="background: @_Preset.Css"
                                @onclick="() => this.OnPresetSelected.InvokeAsync(_Preset)"></button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {

    #region Properties

    [Parameter, EditorRequired] public LightDto Light { get; set; } = default!;
    [Parameter, EditorRequired] public long GroupID { get; set; }
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public IReadOnlyList<LightGroupDto> Groups { get; set; } = [];
    [Parameter] public EventCallback<bool> OnPowerChanged { get; set; }
    [Parameter] public EventCallback<double> OnBrightnessCommitted { get; set; }
    [Parameter] public EventCallback<ColourPreset> OnPresetSelected { get; set; }
    [Parameter] public EventCallback<long> OnGroupChanged { get; set; }

    #endregion Properties

    #region Methods

    private static int Percent(double value)
        => (int)Math.Round(Math.Clamp(value, 0d, 1d) * 100d);

    private string StatusText()
        => !this.Light.IsConnected ? "Offline"
            : this.Light.IsOn ? $"On · {Percent(this.Light.Brightness)}%"
            : "Off";

    private async Task OnGroupSelected(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var _GroupID) && _GroupID != this.GroupID)
            await this.OnGroupChanged.InvokeAsync(_GroupID);
    }

    #endregion Methods

}
