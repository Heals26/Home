@* One bulb: power, brightness, colour, and in edit mode the group it belongs to. *@

<div class="bg-ink-900 border border-ink-800 rounded-2xl p-4">
    <div class="flex items-center gap-3">
        <span class="h-10 w-10 rounded-full shrink-0 border border-ink-700"
              style="background: @ColourPreset.SwatchFor(this.Light.IsConnected, this.Light.IsOn, this.Light.Brightness, this.Light.Hue, this.Light.Saturation)"></span>

        <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-ink-50 truncate">@this.Light.Label</p>
            <p class="text-xs text-ink-500 flex items-center gap-2 min-w-0">
                <span class="truncate">@this.StatusText()</span>

                @* Home knows the bulb has addressable zones even though it can only set the whole
                   strip at once — saying so beats pretending the hardware is something simpler. *@
                @if (this.ZoneBadge() is { } _ZoneBadge)
                {
                    <span class="shrink-0 rounded border border-ink-700 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-ink-400"
                          title="This one has individually addressable zones. Home sets the whole light at once.">@_ZoneBadge</span>
                }
            </p>
        </div>

        @if (!this.EditMode)
        {
            <HomeToggle Value="this.Light.IsOn"
                        Disabled="!this.Light.IsConnected"
                        ValueChanged="on => this.OnPowerChanged.InvokeAsync(on)" />
        }
    </div>

    @if (this.EditMode)
    {
        <div class="mt-3 pt-3 border-t border-ink-800">
            <label for="@($"light-group-{this.Light.ID}")" class="text-xs font-medium text-ink-400 block mb-1">Group</label>
            <select id="@($"light-group-{this.Light.ID}")"
                    class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px]"
                    value="@this.GroupID"
                    @onchange="this.OnGroupSelected">
                @foreach (var _Group in this.Groups)
                {
                    <option value="@_Group.LightGroupID">@_Group.Name</option>
                }
            </select>
        </div>
    }
    else if (this.Light.IsConnected && this.Light.IsOn)
    {
        <div class="mt-4 pt-4 border-t border-ink-800 flex flex-col gap-4">
            <HomeColourWheel Brightness="this.Light.Brightness"
                             BrightnessChanged="b => this.Light.Brightness = b"
                             BrightnessCommitted="b => this.OnBrightnessCommitted.InvokeAsync(b)"
                             ColourChanged="this.PreviewColour"
                             ColourCommitted="c => this.OnColourCommitted.InvokeAsync(c)"
                             HasColour="this.Light.HasColour"
                             HasVariableColourTemp="this.Light.HasVariableColourTemp"
                             Hue="this.Light.Hue"
                             Kelvin="this.Light.Kelvin"
                             KelvinChanged="k => this.Light.Kelvin = k"
                             KelvinCommitted="k => this.OnKelvinCommitted.InvokeAsync(k)"
                             MaxKelvin="this.Light.MaxKelvin"
                             MinKelvin="this.Light.MinKelvin"
                             Saturation="this.Light.Saturation" />

            @* Only offer what the hardware can honour: a white-only bulb gets whites, a bulb with
               no variable temperature gets no whites either. *@
            @if (this.AvailablePresets().Any())
            {
                <div>
                    <p class="text-sm font-medium text-ink-300 mb-2">
                        @(this.Light.HasColour ? "Colour" : "Warmth")
                    </p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var _Preset in this.AvailablePresets())
                        {
                            <button type="button"
                                    title="@_Preset.Name"
                                    aria-label="@_Preset.Name"
                                    class="h-11 w-11 rounded-lg border transition-all active:scale-95 @(this.IsCurrent(_Preset) ? "border-lights ring-2 ring-lights/40" : "border-ink-700 hover:border-ink-500")"
                                    style="background: @_Preset.Css"
                                    @onclick="() => this.OnPresetSelected.InvokeAsync(_Preset)"></button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
