@page "/lights"

<CascadingValue Value="this.m_CancellationTokenHandler.Token" Name="CancellationToken">
    <div class="flex flex-col h-full max-w-4xl mx-auto w-full">
        <HomeTopBar Title="Lights" Eyebrow="Around the house" EyebrowClass="text-lights">
            <ActionsContent>
                @if (this.m_Groups?.Count > 0)
                {
                    <HomeButton Size="sm"
                                Variant="@(this.m_EditMode ? "primary" : "ghost")"
                                OnClick="this.ToggleEditMode">
                        @(this.m_EditMode ? "Done" : "Edit")
                    </HomeButton>
                }

                @* This page shows what Home last recorded, which is only the room after a sync. *@
                @if (this.FreshnessText() is { } _Freshness)
                {
                    <span class="hidden sm:inline text-xs text-ink-600 whitespace-nowrap">@_Freshness</span>
                }

                <HomeButton Size="sm" Variant="ghost" OnClick="this.SyncLightsAsync" Loading="this.m_Syncing">
                    <span class="home-icon home-icon-refresh h-4 w-4 mr-1 inline-block"></span>
                    Sync
                </HomeButton>
            </ActionsContent>
        </HomeTopBar>

        <div class="flex-1 px-6 pb-6 app-scrollable">
            @if (this.m_Groups == null)
            {
                <HomeLoader Class="py-16" />
            }
            else if (this.m_Groups.Count == 0)
            {
                <HomeEmptyState Title="No lights yet"
                                Subtitle="Sync to pull your bulbs in from LIFX. You can regroup and rename them here afterwards.">
                    <ActionContent>
                        <HomeButton OnClick="this.SyncLightsAsync" Loading="this.m_Syncing">Sync now</HomeButton>
                    </ActionContent>
                </HomeEmptyState>
            }
            else
            {
                <div class="flex flex-col gap-8">

                    @* ── Scenes ────────────────────────────────────────── *@
                    <section>
                        <div class="flex items-center justify-between mb-3 px-1">
                            <h2 class="text-xs font-semibold text-ink-500 uppercase tracking-widest">Scenes</h2>
                            <HomeButton Size="sm" Variant="secondary" OnClick="this.OpenCaptureModalAsync">
                                <span class="home-icon home-icon-sparkles h-4 w-4 mr-1 inline-block"></span>
                                Save current look
                            </HomeButton>
                        </div>

                        @if (this.m_Scenes == null)
                        {
                            <div class="flex gap-2 animate-pulse">
                                <div class="h-12 w-28 rounded-xl bg-ink-800"></div>
                                <div class="h-12 w-28 rounded-xl bg-ink-800"></div>
                            </div>
                        }
                        else if (this.m_Scenes.Count == 0)
                        {
                            <div class="flex flex-col items-start gap-3 rounded-2xl border border-dashed border-ink-700 px-4 py-4">
                                <p class="text-sm text-ink-400">
                                    Get the room looking right, then save it as a scene to bring back any time.
                                </p>
                                <HomeButton Size="sm" OnClick="this.OpenCaptureModalAsync">
                                    <span class="home-icon home-icon-sparkles h-4 w-4 mr-1 inline-block"></span>
                                    Save how the lights look now
                                </HomeButton>
                            </div>
                        }
                        else
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var _Scene in this.m_Scenes)
                                {
                                    <div class="relative">
                                        <button type="button"
                                                class="flex items-center gap-2 min-h-[48px] rounded-xl border border-ink-700 bg-ink-900 hover:border-lights/60 active:scale-95 transition-all px-4 py-2 disabled:opacity-60"
                                                disabled="@(this.m_ApplyingSceneID != null)"
                                                @onclick="() => this.ApplySceneAsync(_Scene)">
                                            @if (this.m_ApplyingSceneID == _Scene.LightSceneID)
                                            {
                                                <span class="inline-block h-4 w-4 border-2 border-current border-t-transparent rounded-full animate-spin text-lights"></span>
                                            }
                                            else
                                            {
                                                <span class="home-icon home-icon-sparkles h-4 w-4 text-lights"></span>
                                            }
                                            <span class="text-sm font-medium text-ink-100">@_Scene.Name</span>
                                            <span class="text-xs text-ink-500">@_Scene.LightCount</span>
                                        </button>

                                        @if (this.m_EditMode)
                                        {
                                            <button type="button"
                                                    title="Delete scene"
                                                    aria-label="@($"Delete {_Scene.Name}")"
                                                    class="absolute -top-2 -right-2 h-6 w-6 rounded-full bg-ink-800 border border-ink-700 text-ink-400 hover:text-red-400 flex items-center justify-center"
                                                    @onclick="() => this.DeleteSceneAsync(_Scene)">
                                                <span class="home-icon home-icon-x h-3 w-3"></span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    @* ── Rooms ─────────────────────────────────────────── *@
                    @foreach (var _Group in this.m_Groups)
                    {
                        <LightGroupCard Group="_Group"
                                        AllGroups="this.m_Groups"
                                        EditMode="this.m_EditMode"
                                        IsFirst="_Group == this.m_Groups[0]"
                                        IsLast="_Group == this.m_Groups[^1]"
                                        OnGroupPower="on => this.SetGroupPowerAsync(_Group, on)"
                                        OnRenamed="name => this.RenameGroupAsync(_Group, name)"
                                        OnMoved="delta => this.MoveGroupAsync(_Group, delta)"
                                        OnDeleted="() => this.DeleteGroupAsync(_Group)"
                                        OnEffects="() => this.OpenEffectsModal(_Group)"
                                        OnLightPower="a => this.SetPowerAsync(a.Light, a.IsOn)"
                                        OnLightBrightness="a => this.SetBrightnessAsync(a.Light, a.Brightness)"
                                        OnLightColour="a => this.ApplyColourAsync(a.Light, a.Hue, a.Saturation)"
                                        OnLightKelvin="a => this.ApplyKelvinAsync(a.Light, a.Kelvin)"
                                        OnLightPreset="a => this.ApplyPresetAsync(a.Light, a.Preset)"
                                        OnLightMoved="a => this.MoveLightAsync(a.Light, a.GroupID)" />
                    }

                    @if (this.m_EditMode)
                    {
                        <div class="flex gap-2">
                            <input class="flex-1 min-w-0 bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 placeholder-ink-500 min-h-[48px]"
                                   maxlength="250"
                                   placeholder="New group name"
                                   autocomplete="off"
                                   aria-label="New group name"
                                   @bind="this.m_NewGroupName"
                                   @bind:event="oninput" />

                            <HomeButton OnClick="this.CreateGroupAsync"
                                        Disabled="@string.IsNullOrWhiteSpace(this.m_NewGroupName)"
                                        DisabledReason="Type a name for the group first.">Add group</HomeButton>
                        </div>
                    }

                    @* ── Schedules ─────────────────────────────────────── *@
                    <section>
                        <div class="flex items-center justify-between mb-3 px-1">
                            <h2 class="text-xs font-semibold text-ink-500 uppercase tracking-widest">Schedules</h2>
                            @* Always opens: with no scenes yet the modal explains and offers the next step. *@
                            <HomeButton Size="sm" Variant="ghost" OnClick="this.OpenScheduleModal">
                                <span class="home-icon home-icon-plus h-4 w-4 mr-1 inline-block"></span>
                                Add schedule
                            </HomeButton>
                        </div>

                        @if (this.m_Schedules == null)
                        {
                            <div class="h-14 rounded-2xl bg-ink-800 animate-pulse"></div>
                        }
                        else if (this.m_Schedules.Count == 0)
                        {
                            <p class="text-sm text-ink-500 px-1">
                                @(this.m_Scenes?.Count > 0
                                    ? "Fire a scene at the same time each day — wind-downs, wake-ups, dinner time."
                                    : "Save a scene first, then schedule it to fire at the same time each day.")
                            </p>
                        }
                        else
                        {
                            <div class="flex flex-col gap-2">
                                @foreach (var _Schedule in this.m_Schedules)
                                {
                                    <div class="flex items-center gap-3 bg-ink-900 border border-ink-800 rounded-2xl px-4 py-3">
                                        <HomeToggle Value="_Schedule.IsEnabled"
                                                    ValueChanged="on => this.ToggleScheduleAsync(_Schedule, on)" />
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-medium truncate @(_Schedule.IsEnabled ? "text-ink-50" : "text-ink-500")">@_Schedule.Name</p>
                                            <p class="text-xs text-ink-500 truncate">
                                                @_Schedule.SceneName · @FormatTrigger(_Schedule) · @FormatDays(_Schedule.DaysOfWeek)
                                            </p>
                                        </div>
                                        @if (this.m_EditMode)
                                        {
                                            <button type="button" title="Delete schedule" aria-label="@($"Delete {_Schedule.Name}")"
                                                    class="h-11 w-11 rounded-lg text-ink-500 hover:text-red-400 shrink-0"
                                                    @onclick="() => this.DeleteScheduleAsync(_Schedule)">
                                                <span class="home-icon home-icon-trash h-4 w-4 inline-block"></span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    @if (this.m_LastSynced != null)
                    {
                        <p class="text-xs text-ink-600 text-center pb-2">Last synced @this.m_LastSynced</p>
                    }
                </div>
            }
        </div>
    </div>
</CascadingValue>

@* ── Save-scene modal ─────────────────────────────────────────── *@
<HomeModal @bind-Visible="this.m_ShowCaptureModal" Title="Save current look">
    <ChildContent>
        <div class="flex flex-col gap-4">
            @if (this.m_CaptureSyncing)
            {
                <p class="text-xs text-ink-500">Reading what the bulbs are doing right now…</p>
            }
            else if (this.m_CaptureUsedLastKnownState)
            {
                <p class="text-xs text-lights">The bulbs didn't answer just now, so this saves the last look Home knew about.</p>
            }
            else
            {
                <p class="text-xs text-ink-500">This saves the lights exactly as they are at the moment.</p>
            }

            <HomeTextInput Label="Name" AutoComplete="off" Placeholder="e.g. Movie night" @bind-Value="this.m_CaptureName" />
            <div class="flex flex-col gap-1.5">
                <label for="scene-capture-group" class="text-sm font-medium text-ink-300">Which lights</label>
                <select id="scene-capture-group"
                        class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px]"
                        @bind="this.m_CaptureGroupID">
                    <option value="0">All lights</option>
                    @foreach (var _Group in this.m_Groups ?? [])
                    {
                        <option value="@_Group.LightGroupID">@_Group.Name</option>
                    }
                </select>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-end gap-2">
            <HomeButton Variant="ghost" OnClick="() => this.m_ShowCaptureModal = false">Cancel</HomeButton>
            <HomeButton OnClick="this.CaptureSceneAsync"
                        Loading="this.m_Capturing"
                        Disabled="@string.IsNullOrWhiteSpace(this.m_CaptureName)"
                        DisabledReason="Name the scene so you can find it again.">Save scene</HomeButton>
        </div>
    </FooterContent>
</HomeModal>

@* ── Add-schedule modal ───────────────────────────────────────── *@
<HomeModal @bind-Visible="this.m_ShowScheduleModal" Title="Add schedule">
    <ChildContent>
        @if (this.m_Scenes == null || this.m_Scenes.Count == 0)
        {
            <div class="flex flex-col items-start gap-4">
                <p class="text-sm text-ink-400">
                    A schedule fires a saved scene, and this home hasn't got one yet. Set the lights how
                    you want them, save that as a scene, then come back and give it a time.
                </p>
                <HomeButton OnClick="this.CaptureSceneFromScheduleAsync">
                    <span class="home-icon home-icon-sparkles h-4 w-4 mr-1 inline-block"></span>
                    Save a scene first
                </HomeButton>
            </div>
        }
        else
        {
        <div class="flex flex-col gap-4">
            <HomeTextInput Label="Name" AutoComplete="off" Placeholder="e.g. Wind down" @bind-Value="this.m_ScheduleName" />

            <div class="flex flex-col gap-1.5">
                <label for="schedule-scene" class="text-sm font-medium text-ink-300">Scene</label>
                <select id="schedule-scene"
                        class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px]"
                        @bind="this.m_ScheduleSceneID">
                    <option value="0">Choose a scene</option>
                    @foreach (var _Scene in this.m_Scenes ?? [])
                    {
                        <option value="@_Scene.LightSceneID">@_Scene.Name</option>
                    }
                </select>
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-ink-300">When</label>
                <HomeSegmentedControl TValue="LightScheduleTrigger"
                                      Options="TriggerOptions"
                                      @bind-Value="this.m_ScheduleTrigger" />
            </div>

            @if (this.m_ScheduleTrigger == LightScheduleTrigger.Time)
            {
                <div class="flex flex-col gap-1.5">
                    <label for="schedule-time" class="text-sm font-medium text-ink-300">Time</label>
                    <input id="schedule-time" type="time"
                           class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px]"
                           value="@this.m_ScheduleTime"
                           @onchange="e => this.m_ScheduleTime = e.Value?.ToString() ?? string.Empty" />
                </div>
            }
            else
            {
                <div class="flex flex-col gap-1.5">
                    <label for="schedule-offset" class="text-sm font-medium text-ink-300">
                        How close to @(this.m_ScheduleTrigger == LightScheduleTrigger.Sunrise ? "sunrise" : "sunset")
                    </label>
                    <select id="schedule-offset" @bind="this.m_ScheduleOffsetMinutes"
                            class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px]">
                        @foreach (var _Offset in OffsetOptions)
                        {
                            <option value="@_Offset.Minutes">@_Offset.Label</option>
                        }
                    </select>
                    <p class="text-xs text-ink-500">Follows the sun for this home's location, set on the Settings page.</p>
                </div>
            }

            <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-ink-300">Days</label>
                <div class="flex gap-1.5">
                    @foreach (var _Day in ScheduleDays)
                    {
                        <button type="button"
                                class="flex-1 min-h-[44px] rounded-lg border text-sm font-medium transition-colors @(this.IsDaySelected(_Day.Bit) ? "border-lights/60 bg-lights/10 text-lights" : "border-ink-700 text-ink-400 hover:text-ink-200")"
                                @onclick="() => this.ToggleDay(_Day.Bit)">
                            @_Day.Label
                        </button>
                    }
                </div>
            </div>
        </div>
        }
    </ChildContent>
    <FooterContent>
        <div class="flex justify-end gap-2">
            <HomeButton Variant="ghost" OnClick="() => this.m_ShowScheduleModal = false">Cancel</HomeButton>
            @if (this.m_Scenes?.Count > 0)
            {
                <HomeButton OnClick="this.CreateScheduleAsync"
                            Loading="this.m_CreatingSchedule"
                            Disabled="@(!this.CanCreateSchedule())"
                            DisabledReason="@this.ScheduleBlockedReason()">Add schedule</HomeButton>
            }
        </div>
    </FooterContent>
</HomeModal>

@* ── Effects modal ────────────────────────────────────────────── *@
<HomeModal @bind-Visible="this.m_ShowEffectsModal" Title="@($"Effects — {this.m_EffectsGroup?.Name}")">
    <ChildContent>
        <div class="flex flex-col gap-4">
            <p class="text-sm text-ink-400">
                Runs for a little while, then the lights go back to how they were.
            </p>

            <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-ink-300">Effect</label>
                <HomeSegmentedControl TValue="LightEffectKind"
                                      @bind-Value="this.m_EffectKind"
                                      Options="EffectOptions" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-ink-300">Colour</label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var _Preset in ColourPreset.All.Where(p => !p.IsWhite))
                    {
                        <button type="button"
                                title="@_Preset.Name"
                                aria-label="@_Preset.Name"
                                class="h-11 w-11 rounded-lg border transition-all active:scale-95 @(this.m_EffectPreset == _Preset ? "border-lights ring-2 ring-lights/40" : "border-ink-700 hover:border-ink-500")"
                                style="background: @_Preset.Css"
                                @onclick="() => this.m_EffectPreset = _Preset"></button>
                    }
                </div>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-between gap-2">
            <HomeButton Variant="ghost" OnClick="this.StopEffectAsync" Loading="this.m_StoppingEffect">
                <span class="home-icon home-icon-stop h-4 w-4 mr-1 inline-block"></span>
                Stop
            </HomeButton>
            <HomeButton OnClick="this.StartEffectAsync"
                        Loading="this.m_StartingEffect"
                        Disabled="@(this.m_EffectPreset == null)"
                        DisabledReason="Pick a colour for the effect first.">Start</HomeButton>
        </div>
    </FooterContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
