@* One room: its header controls act on the whole group in a single API call. *@

<section>
    <div class="flex items-center justify-between mb-3 px-1 gap-2">
        @if (this.EditMode)
        {
            <input class="flex-1 min-w-0 bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px]"
                   value="@this.Group.Name"
                   maxlength="250"
                   autocomplete="off"
                   aria-label="Group name"
                   @onchange="this.OnNameChanged" />

            <HomeReorder Label="@this.Group.Name"
                         CanMoveUp="!this.IsFirst"
                         CanMoveDown="!this.IsLast"
                         OnMoveUp="() => this.OnMoved.InvokeAsync(-1)"
                         OnMoveDown="() => this.OnMoved.InvokeAsync(1)" />

            <HomeButton IconOnly Size="sm" Variant="ghost" Class="hover:text-red-400"
                        title="Delete group"
                        aria-label="@($"Delete {this.Group.Name}")"
                        Disabled="@(this.Group.Lights.Count > 0)"
                        DisabledReason="Move its lights to another group first."
                        OnClick="() => this.OnDeleted.InvokeAsync()">
                <HomeIcon Name="trash" />
            </HomeButton>
        }
        else
        {
            <h2 class="text-xs font-semibold text-ink-500 uppercase tracking-widest">@this.Group.Name</h2>

            <div class="flex gap-2">
                @if (this.Group.Lights.Any(l => l.IsConnected))
                {
                    <HomeButton Variant="ghost" Size="sm"
                                Class="h-9 px-3 enabled:hover:text-lights"
                                title="Effects" aria-label="Effects"
                                OnClick="() => this.OnEffects.InvokeAsync()">
                        <HomeIcon Name="sparkles" />
                    </HomeButton>
                }
                <HomeButton Size="sm" Variant="ghost" OnClick="() => this.OnGroupPower.InvokeAsync(false)">All Off</HomeButton>
                <HomeButton Size="sm" Variant="ghost" OnClick="() => this.OnGroupPower.InvokeAsync(true)">All On</HomeButton>
            </div>
        }
    </div>

    @if (this.Group.Lights.Count == 0)
    {
        <p class="text-xs text-ink-600 px-1 pb-2">
            No lights in this group@(this.EditMode ? "." : " — switch to Edit to move some here.")
        </p>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
            @foreach (var _Light in this.Group.Lights)
            {
                <LightControlCard Light="_Light"
                                  GroupID="this.Group.LightGroupID"
                                  EditMode="this.EditMode"
                                  Groups="this.AllGroups"
                                  OnPowerChanged="on => this.OnLightPower.InvokeAsync((_Light, on))"
                                  OnBrightnessCommitted="b => this.OnLightBrightness.InvokeAsync((_Light, b))"
                                  OnColourCommitted="c => this.OnLightColour.InvokeAsync((_Light, c.Hue, c.Saturation))"
                                  OnKelvinCommitted="k => this.OnLightKelvin.InvokeAsync((_Light, k))"
                                  OnPresetSelected="p => this.OnLightPreset.InvokeAsync((_Light, p))"
                                  OnGroupChanged="g => this.OnLightMoved.InvokeAsync((_Light, g))" />
            }
        </div>
    }
</section>
