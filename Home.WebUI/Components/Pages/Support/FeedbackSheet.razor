@inject IFeedbackLogic FeedbackLogic

<HomeModal Visible="this.Visible"
           VisibleChanged="this.OnVisibleChangedAsync"
           Title="Send feedback"
           OnSubmit="this.SendAsync">
    <ChildContent>
        @if (this.m_Sent)
        {
            <div class="flex flex-col items-center gap-3 py-6 text-center">
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-ink-800 text-ink-50">
                    <HomeIcon Name="check" Size="lg" />
                </span>
                <p class="font-display text-xl text-ink-50">Feedback sent</p>
            </div>
            <div class="flex justify-end">
                <HomeButton OnClick="this.CloseAsync">Done</HomeButton>
            </div>
        }
        else
        {
            <div class="flex flex-col gap-4">
                <HomeSegmentedControl TValue="FeedbackKind" Class="self-start" Options="m_Kinds" @bind-Value="this.m_Kind" />
                <HomeTextArea Label="@this.ContentLabel"
                              Rows="5"
                              maxlength="2000"
                              @bind-Value="this.m_Content" />
                @* Inline rather than through ErrorHandler: its toasts sit under an open dialog. *@
                @if (this.m_Error != null)
                {
                    <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm">
                        <p class="font-semibold text-red-400">@this.m_Error.Title</p>
                        @if (!string.IsNullOrWhiteSpace(this.m_Error.Detail))
                        {
                            <p class="mt-0.5 text-xs text-ink-300">@this.m_Error.Detail</p>
                        }
                        @foreach (var _Message in this.m_Error.Errors.SelectMany(e => e.Value))
                        {
                            <p class="mt-0.5 text-xs text-ink-300">@_Message</p>
                        }
                    </div>
                }
                <div class="flex justify-end gap-3">
                    <HomeButton Variant="ghost" OnClick="this.CloseAsync">Cancel</HomeButton>
                    <HomeButton Loading="this.m_Sending"
                                Disabled="@string.IsNullOrWhiteSpace(this.m_Content)"
                                OnClick="this.SendAsync">Send</HomeButton>
                </div>
            </div>
        }
    </ChildContent>
</HomeModal>
