@* The same days as a single column: one card per day, its things in order. What a phone carries,
   and what the month grid opens into when a day has more on it than a cell can say. *@

<div class="flex flex-col gap-3 max-w-3xl mx-auto">
    @foreach (var _Day in this.Days)
    {
        var _IsToday = _Day.Date == this.Today;

        <section class="rounded-2xl border @(_IsToday ? "border-calendar/40" : "border-ink-800") bg-ink-900 p-3">
            <div class="flex items-center justify-between gap-3 mb-2">
                <div class="min-w-0">
                    <p class="text-[11px] font-semibold uppercase tracking-widest @(_IsToday ? "text-calendar" : "text-ink-500")">@CalendarFormat.DayHeading(_Day.Date, this.Today)</p>
                    <p class="font-display text-xl text-ink-50 truncate">@CalendarFormat.LongDate(_Day.Date)</p>
                </div>
                <HomeButton IconOnly Size="sm" Variant="ghost"
                            Class="text-ink-500 enabled:hover:text-ink-50"
                            aria-label="@($"Add something on {CalendarFormat.LongDate(_Day.Date)}")"
                            title="@($"Add something on {CalendarFormat.LongDate(_Day.Date)}")"
                            OnClick="() => this.OnSelectDay.InvokeAsync(_Day.Date)">
                    <HomeIcon Name="plus" Size="sm" />
                </HomeButton>
            </div>

            @if (_Day.Items.Count == 0)
            {
                <p class="px-1 py-2 text-sm text-ink-600">Nothing on.</p>
            }
            else
            {
                <div class="flex flex-col gap-1.5">
                    @foreach (var _Item in _Day.Items)
                    {
                        <CalendarItemChip Item="_Item" OnClick="this.OnSelectItem" />
                    }
                </div>
            }
        </section>
    }
</div>
