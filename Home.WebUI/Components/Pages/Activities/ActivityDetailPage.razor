@page "/activities/{ActivityID:long}"

<HomePageTitle Title="@this.m_Activity?.Title" />

<CascadingValue Value="this.m_CancellationTokenHandler.Token" Name="CancellationToken">
    <div class="flex flex-col h-full">
        <HomeTopBar Title="@(this.m_Activity?.Title ?? "Activity")"
                    Eyebrow="Family board"
                    EyebrowClass="text-week"
                    ShowBack="true"
                    BackHref="/activities">
            <ActionsContent>
                @if (this.m_Activity != null)
                {
                    <HomeButton Size="sm" Variant="ghost" OnClick="() => this.m_ShowEdit = true">
                        <span class="home-icon home-icon-pencil h-4 w-4 mr-1 inline-block"></span>
                        Edit
                    </HomeButton>
                }
            </ActionsContent>
        </HomeTopBar>

        <div class="flex-1 px-6 pb-6 app-scrollable">
            @if (this.m_Activity == null)
            {
                <HomeLoader Class="py-16" />
            }
            else
            {
                <div class="max-w-3xl mx-auto flex flex-col gap-4">

                    <HomeCard>
                        <ChildContent>
                            <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                                <div>
                                    <p class="text-xs uppercase tracking-widest text-ink-500">Column</p>
                                    <p class="text-sm text-ink-100 mt-0.5">@(this.m_Activity.State ?? "Not sorted")</p>
                                </div>
                                <div>
                                    <p class="text-xs uppercase tracking-widest text-ink-500">Due</p>
                                    <p class="text-sm text-ink-100 mt-0.5">
                                        @if (this.m_Activity.DueDateUTC.HasValue)
                                        {
                                            <span>@ActivityBoardLogic.DescribeDate(this.m_Activity.DueDateUTC.Value)</span>
                                            @if (this.m_Activity.DueTime.HasValue)
                                            {
                                                <span class="text-week"> at @ActivityBoardLogic.DescribeTime(this.m_Activity.DueTime.Value)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-ink-500">No date</span>
                                        }
                                    </p>
                                </div>
                                <div>
                                    <p class="text-xs uppercase tracking-widest text-ink-500">Who</p>
                                    <p class="text-sm text-ink-100 mt-0.5">@(string.IsNullOrWhiteSpace(this.m_Activity.AssignedTo) ? "Anyone" : this.m_Activity.AssignedTo)</p>
                                </div>
                            </div>

                            @if (this.m_Activity.Tags.Any())
                            {
                                <div class="flex flex-wrap gap-2 mt-4">
                                    @foreach (var _Tag in this.m_Activity.Tags)
                                    {
                                        <span class="text-xs font-semibold text-ink-950 rounded-full px-3 py-1"
                                              style="background-color:@ActivityBoardLogic.SafeColour(_Tag.Colour)">@_Tag.Name</span>
                                    }
                                </div>
                            }
                        </ChildContent>
                    </HomeCard>

                    @foreach (var _RegionKind in RegionKinds)
                    {
                        var _Region = this.GetRegion(_RegionKind);

                        <HomeCard Title="@ActivityBoardLogic.RegionLabel(_RegionKind)"
                                  Subtitle="@ActivityBoardLogic.RegionBlurb(_RegionKind)">
                            <ActionsContent>
                                <HomeButton Size="sm" Variant="secondary" OnClick="() => this.OpenAddFieldModal(_RegionKind)">
                                    <span class="home-icon home-icon-plus h-4 w-4 mr-1 inline-block"></span>
                                    Add
                                </HomeButton>
                            </ActionsContent>
                            <ChildContent>
                                @if (_Region == null || _Region.Fields.Count == 0)
                                {
                                    <p class="text-sm text-ink-500 py-2">Nothing written here yet.</p>
                                }
                                else
                                {
                                    <div class="divide-y divide-ink-800 -mx-5 -mb-5">
                                        @foreach (var _Field in _Region.Fields)
                                        {
                                            <div class="flex items-start gap-2 px-5 py-3">
                                                <p class="flex-1 min-w-0 text-sm text-ink-100 whitespace-pre-wrap break-words">@_Field.Content</p>
                                                <button type="button"
                                                        class="h-12 w-12 shrink-0 flex items-center justify-center rounded-lg text-ink-400 hover:text-ink-50 hover:bg-ink-800 active:scale-95 transition"
                                                        title="Edit"
                                                        aria-label="Edit this note"
                                                        @onclick="() => this.OpenEditFieldModal(_RegionKind, _Field)">
                                                    <span class="home-icon home-icon-pencil h-4 w-4 inline-block"></span>
                                                </button>
                                                <button type="button"
                                                        class="h-12 w-12 shrink-0 flex items-center justify-center rounded-lg text-ink-400 hover:text-red-400 hover:bg-ink-800 active:scale-95 transition"
                                                        title="Delete"
                                                        aria-label="Delete this note"
                                                        @onclick="() => this.DeleteFieldAsync(_Field.ActivityContentID)">
                                                    <span class="home-icon home-icon-trash h-4 w-4 inline-block"></span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </ChildContent>
                        </HomeCard>
                    }
                </div>
            }
        </div>
    </div>

    <ActivityEditModal @bind-Visible="this.m_ShowEdit"
                       Activity="this.GetSummary()"
                       States="this.m_States"
                       Tags="this.m_Tags"
                       Users="this.m_Users"
                       ErrorHandler="this.m_ErrorHandler"
                       OnDeleted="this.GoBackToBoard"
                       OnSaved="this.ReloadAndPublishAsync" />

    <HomeModal @bind-Visible="this.m_ShowField" Title="@(this.m_EditingContentID.HasValue ? "Edit" : "Add to the card")">
        <ChildContent>
            <div class="flex flex-col gap-1.5">
                <label for="activity-field-content" class="text-sm font-medium text-ink-300">@ActivityBoardLogic.RegionLabel(this.m_FieldRegionKind)</label>
                <textarea id="activity-field-content"
                          rows="5"
                          @bind="this.m_FieldContent"
                          spellcheck="true"
                          placeholder="Write it the way you'd say it"
                          class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 placeholder-ink-500 focus:outline-none focus:ring-2 focus:ring-ink-300"></textarea>
            </div>
            <div class="mt-4 flex justify-end gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowField = false">Cancel</HomeButton>
                <HomeButton Loading="this.m_Saving" OnClick="this.SaveFieldAsync">Save</HomeButton>
            </div>
        </ChildContent>
    </HomeModal>
</CascadingValue>

<ErrorHandler @ref="this.m_ErrorHandler" />
