@* The columns view. Drag works on a desktop; the chevrons are what actually gets used on the
   tablet, so they stay 48px tall. *@

<div class="flex gap-4 h-full min-h-0 items-start">
    @for (var _Index = 0; _Index < this.m_Columns.Count; _Index++)
    {
        var _Column = this.m_Columns[_Index];
        var _Previous = _Index > 0 ? this.m_Columns[_Index - 1] : null;
        var _Next = _Index < this.m_Columns.Count - 1 ? this.m_Columns[_Index + 1] : null;
        var _PreviousLabel = MoveLabel(_Previous, "Already in the first column");
        var _NextLabel = MoveLabel(_Next, "Already in the last column");
        var _Cards = this.CardsFor(_Column.StateID);

        <div class="flex flex-col w-72 shrink-0 bg-ink-900/60 border border-ink-800 rounded-xl max-h-full"
             data-drop-target=""
             @ondrop="() => this.OnDropAsync(_Column.StateID)">
            <div class="flex items-center justify-between px-4 py-3 border-b border-ink-800 shrink-0">
                <p class="text-sm font-semibold text-ink-200">@_Column.Title</p>
                <span class="text-xs text-week bg-week/10 rounded-full px-2 py-0.5">@_Cards.Count</span>
            </div>
            <div class="flex flex-col gap-2 p-3 overflow-y-auto app-scrollable">
                @foreach (var _Activity in _Cards)
                {
                    <ActivityCard Activity="_Activity"
                                  Draggable="true"
                                  OnDragStart="() => this.OnDragStart(_Activity)"
                                  OnOpen="() => this.OnOpen.InvokeAsync(_Activity)"
                                  OnToggleComplete="isComplete => this.OnToggleComplete.InvokeAsync(new ActivityCompletion(_Activity, isComplete))">
                        <FooterContent>
                            <HomeCardAction Divided="false"
                                            Disabled="_Previous == null || this.Saving"
                                            title="@_PreviousLabel"
                                            aria-label="@_PreviousLabel"
                                            OnClick="() => this.MoveToColumnAsync(_Activity, _Previous)">
                                <HomeIcon Name="chevron-left" Size="lg" />
                            </HomeCardAction>
                            @* Sideways moves the card between columns, up and down moves it within
                               one. Two axes, two pairs of chevrons, and the same gesture on a
                               tablet as on a desktop. *@
                            <HomeCardAction Disabled="this.Saving || _Cards.IndexOf(_Activity) == 0"
                                            title="Move up"
                                            aria-label="@($"Move {_Activity.Title} up")"
                                            OnClick="() => this.MoveWithinColumnAsync(_Activity, _Column.StateID, -1)">
                                <HomeIcon Name="chevron-left" Size="lg" Class="rotate-90" />
                            </HomeCardAction>
                            <HomeCardAction Disabled="this.Saving || _Cards.IndexOf(_Activity) == _Cards.Count - 1"
                                            title="Move down"
                                            aria-label="@($"Move {_Activity.Title} down")"
                                            OnClick="() => this.MoveWithinColumnAsync(_Activity, _Column.StateID, 1)">
                                <HomeIcon Name="chevron-right" Size="lg" Class="rotate-90" />
                            </HomeCardAction>
                            <HomeCardAction title="@($"Edit {_Activity.Title}")"
                                            aria-label="@($"Edit {_Activity.Title}")"
                                            OnClick="() => this.OnEdit.InvokeAsync(_Activity)">
                                <HomeIcon Name="pencil" />
                            </HomeCardAction>
                            <HomeCardAction Disabled="_Next == null || this.Saving"
                                            title="@_NextLabel"
                                            aria-label="@_NextLabel"
                                            OnClick="() => this.MoveToColumnAsync(_Activity, _Next)">
                                <HomeIcon Name="chevron-right" Size="lg" />
                            </HomeCardAction>
                        </FooterContent>
                    </ActivityCard>
                }
                @* An empty column says what to do about it rather than just reporting emptiness —
                   and says a different thing when it is empty because of a filter, since "add an
                   activity" is the wrong advice when the card you want is merely hidden. *@
                @if (_Cards.Count == 0)
                {
                    @if (this.IsFiltered)
                    {
                        <div class="text-center py-6">
                            <p class="text-xs text-ink-600">Nothing here matches</p>
                            <HomeButton Variant="link" Size="sm" Class="mt-2 text-xs text-week px-2"
                                        OnClick="() => this.OnClearFilters.InvokeAsync()">Clear the filters</HomeButton>
                        </div>
                    }
                    else if (_Index == 0)
                    {
                        <div class="text-center py-6">
                            <p class="text-xs text-ink-600">Nothing here yet</p>
                            <HomeButton Variant="link" Size="sm" Class="mt-2 text-xs text-week px-2"
                                        OnClick="() => this.OnAdd.InvokeAsync()">Add the first one</HomeButton>
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-ink-600 text-center py-6">Nothing here yet</p>
                    }
                }
            </div>
        </div>
    }
</div>
