@* Due date, and a time only once there is a day for it to belong to. The toggle is what keeps
   "no particular time" expressible — without it an empty time box is indistinguishable from
   midnight. *@

<div class="grid grid-cols-2 gap-3">
    <HomeTextInput Label="Due date"
                   Type="date"
                   AutoComplete="off"
                   Value="@this.DateValue"
                   OnChange="this.OnDateChangedAsync" />
    <div class="flex flex-col gap-1.5">
        @if (this.Date.HasValue)
        {
            <div class="flex items-center gap-3 min-h-[24px]">
                <HomeToggle Value="this.HasTime" ValueChanged="this.HasTimeChangedAsync" />
                <span class="text-sm font-medium text-ink-300">Set a time</span>
            </div>
            @if (this.HasTime)
            {
                <HomeTextInput Type="time"
                               AutoComplete="off"
                               aria-label="Due time"
                               Value="@this.Time"
                               OnChange="this.OnTimeChangedAsync" />
            }
        }
    </div>
</div>
