@page "/activities"

<HomePageTitle Title="@this.GetViewTitle()" />

<CascadingValue Value="this.m_CancellationTokenHandler.Token" Name="CancellationToken">
    <div class="flex flex-col h-full">
        <HomeTopBar Title="@this.GetViewTitle()" Eyebrow="Family board" EyebrowClass="text-week">
            <ActionsContent>
                <HomeSegmentedControl TValue="string"
                                      Options="ViewOptions"
                                      Value="this.m_View"
                                      ValueChanged="this.SelectView" />
                <HomeButton Size="sm" Variant="ghost" OnClick="() => this.m_ShowBoardSettings = true">
                    <span class="home-icon home-icon-cog h-4 w-4 mr-1 inline-block"></span>
                    Set up board
                </HomeButton>
                <HomeButton Size="sm" OnClick="this.OpenCreateModal">
                    <span class="home-icon home-icon-plus h-4 w-4 mr-1 inline-block"></span>
                    Add activity
                </HomeButton>
            </ActionsContent>
        </HomeTopBar>

        @* Who, what sort, and by when — the three things first-class on a card and, until now, the
           three things the board could not be narrowed by. Filtering happens on the device: the
           week is already loaded, and the answer does not change between taps. *@
        <div class="flex flex-wrap items-center gap-2 px-6 pb-3 shrink-0">
            <select aria-label="Filter by who"
                    class="bg-ink-900 border border-ink-800 rounded-lg px-3 min-h-[44px] text-sm text-ink-200 focus:outline-none focus:ring-2 focus:ring-ink-300"
                    value="@(this.m_FilterUserID?.ToString() ?? string.Empty)"
                    @onchange="this.SetUserFilter">
                <option value="">Anyone</option>
                @foreach (var _User in this.m_Users)
                {
                    <option value="@_User.UserID">@_User.FullName</option>
                }
            </select>

            <select aria-label="Filter by label"
                    class="bg-ink-900 border border-ink-800 rounded-lg px-3 min-h-[44px] text-sm text-ink-200 focus:outline-none focus:ring-2 focus:ring-ink-300"
                    value="@(this.m_FilterTagID?.ToString() ?? string.Empty)"
                    @onchange="this.SetTagFilter">
                <option value="">Any label</option>
                @foreach (var _Tag in this.m_Tags)
                {
                    <option value="@_Tag.TagID">@_Tag.Name</option>
                }
            </select>

            <select aria-label="Filter by when"
                    class="bg-ink-900 border border-ink-800 rounded-lg px-3 min-h-[44px] text-sm text-ink-200 focus:outline-none focus:ring-2 focus:ring-ink-300"
                    value="@this.m_FilterDue"
                    @onchange="this.SetDueFilter">
                <option value="">Any time</option>
                <option value="overdue">Overdue</option>
                <option value="today">Due today</option>
                <option value="week">Due this week</option>
                <option value="none">No date</option>
            </select>

            @if (this.IsFiltered())
            {
                <HomeButton Size="sm" Variant="ghost" OnClick="this.ClearFilters">Clear</HomeButton>
                <p class="text-sm text-ink-500">@this.FilteredActivities().Count of @this.m_Activities.Count</p>
            }
        </div>

        @if (this.m_View != BoardView)
        {
            <div class="flex items-center gap-2 px-6 pb-4 shrink-0">
                <button type="button"
                        class="h-12 w-12 flex items-center justify-center rounded-lg bg-ink-900 border border-ink-800 text-ink-300 hover:bg-ink-800 active:scale-95 transition"
                        title="Earlier"
                        aria-label="Earlier"
                        @onclick="() => this.ShiftAnchor(-1)">
                    <span class="home-icon home-icon-chevron-left h-5 w-5 inline-block"></span>
                </button>
                <button type="button"
                        class="h-12 w-12 flex items-center justify-center rounded-lg bg-ink-900 border border-ink-800 text-ink-300 hover:bg-ink-800 active:scale-95 transition"
                        title="Later"
                        aria-label="Later"
                        @onclick="() => this.ShiftAnchor(1)">
                    <span class="home-icon home-icon-chevron-right h-5 w-5 inline-block"></span>
                </button>
                <HomeButton Size="sm" Variant="secondary" OnClick="this.GoToToday">Today</HomeButton>
                <p class="text-sm text-ink-400 ml-2 truncate">@this.GetPeriodLabel()</p>
            </div>
        }

        <div class="flex-1 min-h-0 px-6 pb-6 overflow-x-auto app-scrollable">
            @if (!this.m_Loaded)
            {
                <HomeLoader Class="py-16" />
            }
            else if (this.m_View == BoardView)
            {
                <ActivityBoardView Activities="this.FilteredActivities()"
                                   IsFiltered="this.IsFiltered()"
                                   OnClearFilters="this.ClearFilters"
                                   OnAdd="this.OpenCreateModal"
                                   States="this.m_States"
                                   Saving="this.m_Saving"
                                   OnEdit="this.OpenEditModal"
                                   OnMove="this.OnMoveAsync"
                                   OnReorder="this.OnReorderAsync"
                                   OnOpen="this.OpenActivity"
                                   OnToggleComplete="this.OnToggleCompleteAsync" />
            }
            else
            {
                <ActivityCalendarView Activities="this.FilteredActivities()"
                                      Days="this.GetDays()"
                                      Today="this.m_Today"
                                      OnEdit="this.OpenEditModal"
                                      OnOpen="this.OpenActivity"
                                      OnToggleComplete="this.OnToggleCompleteAsync" />
            }
        </div>
    </div>

    <BoardSettingsModal @bind-Visible="this.m_ShowBoardSettings"
                        ErrorHandler="this.m_ErrorHandler"
                        OnChanged="this.ReloadAndPublishAsync" />

    <ActivityEditModal @bind-Visible="this.m_ShowEdit"
                       Activity="this.m_EditActivity"
                       States="this.m_States"
                       Tags="this.m_Tags"
                       Users="this.m_Users"
                       ErrorHandler="this.m_ErrorHandler"
                       OnDeleted="this.ReloadAndPublishAsync"
                       OnOpenCard="this.OpenEditedActivity"
                       OnSaved="this.ReloadAndPublishAsync" />

    @* Create activity modal *@
    <HomeModal @bind-Visible="this.m_ShowCreate" Title="New activity" OnSubmit="this.CreateActivityAsync">
        <ChildContent>
            <HomeTextInput Label="Title" AutoComplete="off" @bind-Value="this.m_NewTitle" Placeholder="e.g. Mow the lawn" />

            <div class="flex flex-col gap-1.5 mt-3">
                <label for="activity-new-state" class="text-sm font-medium text-ink-300">Column</label>
                <select id="activity-new-state" @bind="this.m_NewStateID"
                        class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 focus:outline-none focus:ring-2 focus:ring-ink-300 min-h-[48px]">
                    @foreach (var _State in this.m_States)
                    {
                        <option value="@_State.ActivityStateID">@_State.Name</option>
                    }
                </select>
            </div>

            <div class="mt-3">
                <ActivityDueFields IdPrefix="activity-new"
                                   @bind-Date="this.m_NewDueDate"
                                   @bind-HasTime="this.m_NewHasTime"
                                   @bind-Time="this.m_NewDueTime" />
            </div>

            <div class="flex flex-col gap-1.5 mt-3">
                <label for="activity-new-assignee" class="text-sm font-medium text-ink-300">Assign to</label>
                <select id="activity-new-assignee" @bind="this.m_NewUserID"
                        class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 focus:outline-none focus:ring-2 focus:ring-ink-300 min-h-[48px]">
                    <option value="">Anyone</option>
                    @foreach (var _User in this.m_Users)
                    {
                        <option value="@_User.UserID">@_User.FullName</option>
                    }
                </select>
            </div>

            <div class="mt-3">
                <ActivityTagPicker Tags="this.m_Tags" SelectedTagIDs="this.m_NewTagIDs" OnToggle="this.ToggleNewTag" />
            </div>

            <div class="mt-4 flex justify-end gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowCreate = false">Cancel</HomeButton>
                <HomeButton Loading="this.m_Saving" OnClick="this.CreateActivityAsync">Add activity</HomeButton>
            </div>
        </ChildContent>
    </HomeModal>
</CascadingValue>

<ErrorHandler @ref="this.m_ErrorHandler" />
