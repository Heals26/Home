@page "/activities"

<CascadingValue Value="this.m_CancellationTokenHandler.Token" Name="CancellationToken">
    <div class="flex flex-col h-full">
        <HomeTopBar Title="This week" Eyebrow="Family board" EyebrowClass="text-week">
            <ActionsContent>
                <HomeButton Size="sm" OnClick="this.OpenCreateModal">
                    <span class="home-icon home-icon-plus h-4 w-4 mr-1 inline-block"></span>
                    Add activity
                </HomeButton>
            </ActionsContent>
        </HomeTopBar>

        <div class="flex-1 min-h-0 px-6 pb-6 overflow-x-auto app-scrollable">
            @if (this.m_Activities == null || this.m_States == null)
            {
                <HomeLoader Class="py-16" />
            }
            else
            {
                <div class="flex gap-4 h-full min-h-0 items-start">
                    @foreach (var _Column in this.GetColumns())
                    {
                        var _Cards = this.ActivitiesForState(_Column.StateID);
                        <div class="flex flex-col w-72 shrink-0 bg-ink-900/60 border border-ink-800 rounded-xl max-h-full"
                             @ondragover:preventDefault="true"
                             @ondrop="() => this.OnDropAsync(_Column.StateID)">
                            <div class="flex items-center justify-between px-4 py-3 border-b border-ink-800 shrink-0">
                                <p class="text-sm font-semibold text-ink-200">@_Column.Title</p>
                                <span class="text-xs text-week bg-week/10 rounded-full px-2 py-0.5">@_Cards.Count</span>
                            </div>
                            <div class="flex flex-col gap-2 p-3 overflow-y-auto app-scrollable">
                                @foreach (var _Activity in _Cards)
                                {
                                    <div class="bg-ink-800 hover:bg-ink-700 border border-ink-700 rounded-lg p-3 cursor-pointer transition-colors"
                                         draggable="true"
                                         @ondragstart="() => this.OnDragStart(_Activity)"
                                         @onclick="() => this.OpenEditModal(_Activity)">
                                        <p class="text-sm font-medium text-ink-50">@_Activity.Title</p>
                                        <div class="flex items-center gap-3 mt-2">
                                            @if (_Activity.DueDateUTC.HasValue)
                                            {
                                                <span class="inline-flex items-center gap-1 text-xs text-ink-400">
                                                    <span class="home-icon home-icon-calendar h-3.5 w-3.5 inline-block"></span>
                                                    @_Activity.DueDateUTC.Value.ToString("d MMM")
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_Activity.AssignedTo))
                                            {
                                                <span class="text-xs text-ink-500 truncate">@_Activity.AssignedTo</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (!_Cards.Any())
                                {
                                    <p class="text-xs text-ink-600 text-center py-6">Drop activities here</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</CascadingValue>

@* Create activity modal *@
<HomeModal @bind-Visible="this.m_ShowCreate" Title="New activity">
    <ChildContent>
        <HomeTextInput Label="Title" @bind-Value="this.m_NewTitle" Placeholder="e.g. Mow the lawn" />
        <div class="grid grid-cols-2 gap-3 mt-3">
            <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-ink-300">Column</label>
                <select @bind="this.m_NewStateID"
                        class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 focus:outline-none focus:ring-2 focus:ring-ink-300 min-h-[48px]">
                    @foreach (var _State in this.m_States ?? [])
                    {
                        <option value="@_State.ActivityStateID">@_State.Name</option>
                    }
                </select>
            </div>
            <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-ink-300">Due date (optional)</label>
                <input type="date" @bind="this.m_NewDueDate"
                       class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 focus:outline-none focus:ring-2 focus:ring-ink-300 min-h-[48px]" />
            </div>
        </div>
        <div class="mt-4 flex justify-end gap-3">
            <HomeButton Variant="ghost" OnClick="() => this.m_ShowCreate = false">Cancel</HomeButton>
            <HomeButton Loading="this.m_Saving" OnClick="this.CreateActivityAsync">Add activity</HomeButton>
        </div>
    </ChildContent>
</HomeModal>

@* Edit activity modal *@
<HomeModal @bind-Visible="this.m_ShowEdit" Title="Edit activity">
    <ChildContent>
        <HomeTextInput Label="Title" @bind-Value="this.m_EditTitle" Placeholder="Title" />
        <div class="grid grid-cols-2 gap-3 mt-3">
            <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-ink-300">Column</label>
                <select @bind="this.m_EditStateID"
                        class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 focus:outline-none focus:ring-2 focus:ring-ink-300 min-h-[48px]">
                    <option value="">Unassigned</option>
                    @foreach (var _State in this.m_States ?? [])
                    {
                        <option value="@_State.ActivityStateID">@_State.Name</option>
                    }
                </select>
            </div>
            <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-ink-300">Due date</label>
                <input type="date" @bind="this.m_EditDueDate"
                       class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 focus:outline-none focus:ring-2 focus:ring-ink-300 min-h-[48px]" />
            </div>
        </div>
        <div class="mt-5 flex justify-between items-center">
            <HomeButton Variant="danger" Size="sm" Loading="this.m_Saving" OnClick="this.DeleteActivityAsync">Delete</HomeButton>
            <div class="flex gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowEdit = false">Cancel</HomeButton>
                <HomeButton Loading="this.m_Saving" OnClick="this.SaveActivityAsync">Save</HomeButton>
            </div>
        </div>
    </ChildContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
