@* Naming, ordering and colouring the board. Everything here is household vocabulary, so it is
   deliberately all in one place rather than hidden in Settings. *@

<HomeModal Visible="this.Visible" VisibleChanged="this.OnVisibleChangedAsync" Title="Set up the board" OnSubmit="this.SubmitActiveTabAsync" AutoFocus="false">
    <ChildContent>
        <HomeSegmentedControl TValue="string"
                              Class="mb-4"
                              Options="Tabs"
                              Value="this.m_Tab"
                              ValueChanged="this.SelectTab" />

        @if (this.m_Tab == "columns")
        {
            <p class="text-sm text-ink-500 mb-3">Name the columns the way your family talks about them. The one marked below is what "finished" means.</p>

            <div class="divide-y divide-ink-800 border-y border-ink-800">
                @for (var _Index = 0; _Index < this.m_States.Count; _Index++)
                {
                    var _State = this.m_States[_Index];
                    var _IsFirst = _Index == 0;
                    var _IsLast = _Index == this.m_States.Count - 1;

                    <div class="py-3">
                        <div class="flex items-center gap-2">
                            <HomeTextInput Class="flex-1 min-w-0"
                                            AutoComplete="off"
                                            aria-label="Column name"
                                            Value="@_State.Name"
                                            OnChange="name => this.RenameColumnAsync(_State, name)" />
                            <HomeButton IconOnly Variant="ghost"
                                        Disabled="@(_IsFirst || this.m_Saving)"
                                        title="Move left"
                                        aria-label="@($"Move {_State.Name} left")"
                                        OnClick="() => this.MoveColumnAsync(_State, -1)">
                                <HomeIcon Name="chevron-left" Size="lg" Class="rotate-90" />
                            </HomeButton>
                            <HomeButton IconOnly Variant="ghost"
                                        Disabled="@(_IsLast || this.m_Saving)"
                                        title="Move right"
                                        aria-label="@($"Move {_State.Name} right")"
                                        OnClick="() => this.MoveColumnAsync(_State, 1)">
                                <HomeIcon Name="chevron-right" Size="lg" Class="rotate-90" />
                            </HomeButton>
                            <HomeButton IconOnly Variant="ghost" Class="hover:text-red-400"
                                        title="Delete column"
                                        aria-label="@($"Delete {_State.Name}")"
                                        OnClick="() => this.StartDeletingColumn(_State)">
                                <HomeIcon Name="trash" Size="lg" />
                            </HomeButton>
                        </div>

                        <div class="flex items-center gap-3 mt-2">
                            <HomeToggle Value="_State.IsComplete" ValueChanged="v => this.SetColumnCompleteAsync(_State, v)" />
                            <span class="text-sm text-ink-400">Cards here are finished</span>
                        </div>

                        @if (this.m_DeletingStateID == _State.ActivityStateID)
                        {
                            <div class="mt-3 bg-ink-800/60 border border-ink-700 rounded-lg p-3">
                                <p class="text-sm text-ink-200">Where should the cards in "@_State.Name" go?</p>
                                <HomeSelect TValue="long"
                                            Class="mt-2"
                                            aria-label="Move cards to"
                                            Options="this.MoveCardsToOptions(_State)"
                                            @bind-Value="this.m_MoveCardsToStateID" />
                                <div class="flex justify-end gap-2 mt-3">
                                    <HomeButton Size="sm" Variant="ghost" OnClick="this.CancelDeletingColumn">Keep it</HomeButton>
                                    <HomeButton Size="sm" Variant="danger" Loading="this.m_Saving" OnClick="() => this.DeleteColumnAsync(_State)">Move and delete</HomeButton>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="flex items-end gap-2 mt-4">
                <HomeTextInput Class="flex-1"
                               Label="New column"
                               AutoComplete="off"
                               Placeholder="e.g. Waiting on someone"
                               @bind-Value="this.m_NewColumnName" />
                <HomeButton Loading="this.m_Saving" OnClick="this.AddColumnAsync">Add</HomeButton>
            </div>
        }
        else if (this.m_Tab == "sections")
        {
            <p class="text-sm text-ink-500 mb-3">The headings every card is written under. These used to be fixed. Now they are yours.</p>

            <div class="divide-y divide-ink-800 border-y border-ink-800">
                @for (var _Index = 0; _Index < this.m_CardSections.Count; _Index++)
                {
                    var _Section = this.m_CardSections[_Index];
                    var _SectionIndex = _Index;

                    <div class="py-3 flex items-center gap-2">
                        <HomeTextInput Class="flex-1 min-w-0"
                                        AutoComplete="off"
                                        aria-label="Section heading"
                                        Value="@_Section.Name"
                                        OnChange="name => this.RenameSectionAsync(_Section, name)" />

                        <HomeReorder Label="@_Section.Name"
                                     CanMoveUp="@(!this.m_Saving && _SectionIndex > 0)"
                                     CanMoveDown="@(!this.m_Saving && _SectionIndex < this.m_CardSections.Count - 1)"
                                     OnMoveUp="() => this.MoveSectionAsync(_Section, -1)"
                                     OnMoveDown="() => this.MoveSectionAsync(_Section, 1)" />

                        @* A section still written on cards cannot be deleted, because the writing would go
                           with it and there is no undo. The count says why the button is off. *@
                        <HomeButton IconOnly Variant="ghost" Class="hover:text-red-400"
                                    title="@(_Section.CardCount > 0 ? $"Used on {_Section.CardCount} card(s)" : "Delete section")"
                                    aria-label="@($"Delete {_Section.Name}")"
                                    Disabled="@(this.m_Saving || _Section.CardCount > 0)"
                                    OnClick="() => this.DeleteSectionAsync(_Section)">
                            <HomeIcon Name="trash" Size="lg" />
                        </HomeButton>
                    </div>
                }
            </div>

            @if (this.m_CardSections.Count == 0)
            {
                <p class="text-sm text-ink-600 py-4">No sections yet, so a card will just have its title.</p>
            }

            <div class="flex items-end gap-2 mt-4">
                <HomeTextInput Class="flex-1"
                               Label="New section"
                               AutoComplete="off"
                               Placeholder="e.g. What to bring"
                               @bind-Value="this.m_NewSectionName" />
                <HomeButton Loading="this.m_Saving" OnClick="this.AddSectionAsync">Add</HomeButton>
            </div>
        }
        else
        {
            <p class="text-sm text-ink-500 mb-3">Labels colour a card so you can tell at a glance what sort of thing it is.</p>

            @if (this.m_Tags.Count == 0)
            {
                <p class="text-sm text-ink-600 py-4">No labels yet.</p>
            }
            else
            {
                <div class="divide-y divide-ink-800 border-y border-ink-800">
                    @foreach (var _Tag in this.m_Tags)
                    {
                        <div class="py-3">
                            <div class="flex items-center gap-2">
                                <HomeSwatch Size="lg"
                                            Class="border-0"
                                            Style="@($"background-color:{ActivityBoardLogic.SafeColour(_Tag.Colour)}")"
                                            title="Change colour"
                                            aria-label="@($"Change the colour of {_Tag.Name}")"
                                            OnClick="() => this.ToggleTagColour(_Tag)" />
                                <HomeTextInput Class="flex-1 min-w-0"
                                                AutoComplete="off"
                                                aria-label="Label name"
                                                Value="@_Tag.Name"
                                                OnChange="name => this.RenameTagAsync(_Tag, name)" />
                                <HomeButton IconOnly Variant="ghost" Class="hover:text-red-400"
                                            title="Delete label"
                                            aria-label="@($"Delete {_Tag.Name}")"
                                            OnClick="() => this.DeleteTagAsync(_Tag)">
                                    <HomeIcon Name="trash" Size="lg" />
                                </HomeButton>
                            </div>

                            @if (this.m_ColouringTagID == _Tag.TagID)
                            {
                                <HomeColourPicker Class="mt-3"
                                                  Value="@ActivityBoardLogic.SafeColour(_Tag.Colour)"
                                                  ValueChanged="c => this.RecolourTagAsync(_Tag, c)" />
                            }
                        </div>
                    }
                </div>
            }

            <div class="mt-4">
                <HomeTextInput Label="New label"
                               AutoComplete="off"
                               Placeholder="e.g. School"
                               @bind-Value="this.m_NewTagName" />
                <HomeColourPicker Class="mt-3" Label="Colour" @bind-Value="this.m_NewTagColour" />
                <div class="flex justify-end mt-3">
                    <HomeButton Loading="this.m_Saving" OnClick="this.AddTagAsync">Add label</HomeButton>
                </div>
            </div>
        }
    </ChildContent>
</HomeModal>
