@* The quick editor for a card, opened from the board, the calendar and the card itself — so the
   three of them cannot disagree about what is editable. *@

<HomeModal Visible="this.Visible" VisibleChanged="this.OnVisibleChangedAsync" Title="Edit activity" OnSubmit="this.SaveAsync">
    <ChildContent>
        <HomeTextInput Label="Title" AutoComplete="off" @bind-Value="this.m_Title" Placeholder="Title" />

        <HomeSelect TValue="long?"
                    Class="mt-3"
                    Label="Column"
                    Options="this.StateOptions()"
                    @bind-Value="this.m_StateID" />

        <div class="mt-3">
            <ActivityDueFields IdPrefix="activity-edit"
                               @bind-Date="this.m_DueDate"
                               @bind-HasTime="this.m_HasTime"
                               @bind-Time="this.m_DueTime" />
        </div>

        <HomeSelect TValue="long?"
                    Class="mt-3"
                    Label="Assign to"
                    Options="this.UserOptions()"
                    @bind-Value="this.m_UserID" />

        <div class="mt-3">
            <ActivityTagPicker Tags="this.Tags" SelectedTagIDs="this.m_TagIDs" OnToggle="this.ToggleTag" />
        </div>

        @if (this.OnOpenCard.HasDelegate)
        {
            <HomeButton Variant="secondary" Class="w-full mt-4" OnClick="this.OnOpenCard">
                <span class="home-icon home-icon-note h-4 w-4 mr-2 inline-block"></span>
                Open the full card
            </HomeButton>
        }

        <div class="mt-5 flex justify-between items-center">
            <HomeButton Variant="danger" Size="sm" Loading="this.m_Saving" OnClick="this.DeleteAsync">Delete</HomeButton>
            <div class="flex gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.OnVisibleChangedAsync(false)">Cancel</HomeButton>
                <HomeButton Loading="this.m_Saving" OnClick="this.SaveAsync">Save</HomeButton>
            </div>
        </div>
    </ChildContent>
</HomeModal>
