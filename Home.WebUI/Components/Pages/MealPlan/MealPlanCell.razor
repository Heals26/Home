@* One day-and-meal square of the planner. Shared by the wide matrix and the narrow day-by-day
   list so the two layouts can never drift apart.

   The chip is the control: tapping it opens the sheet that moves, opens or removes the meal. It
   used to carry a back chevron, a forward chevron and a cross inline, which is 84px of buttons in
   a column that is about 130px wide on a seven-day tablet grid, leaving a recipe name almost no
   room and no way to tell which meal you were looking at. The same trade was already settled this
   way on the recipe ingredient row.

   Dragging still works for anything with a mouse. The drop target attribute is what board.js
   watches for to allow the drop. *@

<div class="flex flex-wrap items-center gap-1.5 @this.Class"
     data-drop-target=""
     @ondrop="() => this.OnDrop.InvokeAsync()">
    @foreach (var _Entry in this.Entries)
    {
        <button type="button"
                class="flex max-w-full min-w-0 items-center rounded-full border border-ink-700 bg-ink-800 px-3 py-1.5 min-h-[32px] text-left transition-colors hover:border-ink-600 hover:bg-ink-700 disabled:opacity-50"
                draggable="true"
                disabled="@this.Moving"
                title="@_Entry.RecipeName"
                aria-label="@($"{_Entry.RecipeName}, open meal options")"
                @ondragstart="() => this.OnDragStart.InvokeAsync(_Entry)"
                @onclick="() => this.OnSelect.InvokeAsync(_Entry)">
            <span class="truncate text-xs text-ink-100">@_Entry.RecipeName</span>
        </button>
    }
    <button type="button"
            aria-label="@this.AddLabel"
            title="@this.AddLabel"
            class="h-9 w-9 shrink-0 rounded-lg border border-ink-800 text-ink-500 transition-all hover:border-ink-600 hover:text-ink-50 active:scale-95"
            @onclick="this.OnPlan">
        <span class="home-icon home-icon-plus h-3.5 w-3.5 inline-block"></span>
    </button>
</div>
