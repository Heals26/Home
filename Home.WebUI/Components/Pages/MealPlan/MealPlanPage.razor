@page "/meal-plan"

@using Home.WebUI.DataAccess.MealSlots.CreateMealSlot
@using Home.WebUI.DataAccess.MealSlots.GetMealSlots
@using Home.WebUI.DataAccess.MealSlots.Models
@using Home.WebUI.DataAccess.MealSlots.UpdateMealSlot

<HomePageTitle Title="Meals" />

@* The week as a matrix: the household's meals down, the days across. On a phone it folds into a
   day-by-day list so the same week still reads without sideways scrolling. *@

<CascadingValue Value="this.m_CancellationTokenHandler.Token" Name="CancellationToken">
    <div class="flex flex-col h-full w-full">
        <HomeTopBar Title="Meals" Eyebrow="The week's meals" EyebrowClass="text-recipes">
            <ActionsContent>
                <HomeButton Size="sm" Variant="ghost" OnClick="this.OpenManageMealsModal">
                    <HomeIcon Name="cog" />
                </HomeButton>
                <HomeButton Size="sm" Variant="secondary" OnClick="this.OpenAddToListModal"
                            Disabled="@(this.m_Entries == null || this.m_Entries.Count == 0)"
                            DisabledReason="Nothing is planned this week yet.">
                    <HomeIcon Name="shopping-list" Class="mr-1" />
                    Add week to list
                </HomeButton>
            </ActionsContent>
        </HomeTopBar>

        <div class="px-6 pb-3 flex items-center justify-between">
            <div class="flex items-center gap-1">
                <HomeButton IconOnly Size="sm" Variant="ghost" aria-label="Previous week" OnClick="() => this.MoveWeekAsync(-7)">
                    <HomeIcon Name="chevron-left" Size="lg" />
                </HomeButton>
                <HomeButton IconOnly Size="sm" Variant="ghost" aria-label="Next week" OnClick="() => this.MoveWeekAsync(7)">
                    <HomeIcon Name="chevron-right" Size="lg" />
                </HomeButton>
            </div>
            <p class="text-sm font-medium text-ink-300">@this.WeekLabel()</p>
            @if (this.IsCurrentWeek())
            {
                <span class="text-xs text-ink-600 w-16 text-right">This week</span>
            }
            else
            {
                <button type="button" class="text-xs text-ink-300 underline underline-offset-4 hover:text-ink-50 w-16 text-right"
                        @onclick="() => this.GoToTodayAsync()">Today</button>
            }
        </div>

        <div class="flex-1 px-6 pb-6 app-scrollable">
            @if (this.m_Entries == null)
            {
                <HomeLoader Class="py-16" />
            }
            else if (this.m_MealSlots.Count == 0)
            {
                <HomeEmptyState Title="No meals defined yet"
                                Subtitle="Name the meals your family actually eats: breakfast, dinner, whatever you call them.">
                    <ActionContent>
                        <HomeButton OnClick="this.OpenManageMealsModal">Set up meals</HomeButton>
                    </ActionContent>
                </HomeEmptyState>
            }
            else
            {
                @* Wide: meals down, days across *@
                <div class="hidden lg:grid grid-cols-[8rem_repeat(7,minmax(0,1fr))] gap-2">
                    <div></div>
                    @foreach (var _Day in this.WeekDays())
                    {
                        <div class="px-1 pb-1 text-center">
                            <p class="text-xs font-semibold uppercase tracking-widest @(this.IsToday(_Day) ? "text-recipes" : "text-ink-500")">@_Day.ToString("ddd")</p>
                            <p class="text-xs text-ink-500">@_Day.ToString("d MMM")</p>
                        </div>
                    }

                    @foreach (var _MealSlot in this.m_MealSlots)
                    {
                        <div class="flex flex-col justify-center rounded-xl bg-ink-900/60 px-3 py-2">
                            <p class="text-sm font-medium text-ink-100 truncate">@_MealSlot.Name</p>
                            @if (_MealSlot.StartsAt != null)
                            {
                                <p class="text-xs text-ink-600">@this.DescribeStartsAt(_MealSlot.StartsAt)</p>
                            }
                        </div>
                        @foreach (var _Day in this.WeekDays())
                        {
                            <MealPlanCell Class="@(this.IsToday(_Day) ? "min-h-[64px] rounded-xl border border-recipes/40 bg-ink-900 p-2" : "min-h-[64px] rounded-xl border border-ink-800 bg-ink-900/40 p-2")"
                                          AddLabel="@($"Plan {_MealSlot.Name} for {_Day:dddd d MMMM}")"
                                          Entries="this.EntriesFor(_Day, _MealSlot.MealSlotID)"
                                          OnPlan="() => this.OpenPickerAsync(_Day, _MealSlot.MealSlotID)"
                                          OnDrop="() => this.DropEntryAsync(_Day, _MealSlot.MealSlotID)"
                                          Moving="this.m_MovingEntry"
                                          OnDragStart="this.StartDraggingEntry"
                                          OnSelect="this.OpenEntrySheet" />
                        }
                    }

                    @if (this.HasUnassignedEntries())
                    {
                        <div class="flex flex-col justify-center rounded-xl bg-ink-900/60 px-3 py-2">
                            <p class="text-sm font-medium text-ink-400 truncate">Not assigned</p>
                            <p class="text-xs text-ink-600">Planned before meals existed</p>
                        </div>
                        @foreach (var _Day in this.WeekDays())
                        {
                            <MealPlanCell Class="@(this.IsToday(_Day) ? "min-h-[64px] rounded-xl border border-dashed border-recipes/40 p-2" : "min-h-[64px] rounded-xl border border-dashed border-ink-800 p-2")"
                                          AddLabel="@($"Plan a meal for {_Day:dddd d MMMM}")"
                                          Entries="this.EntriesFor(_Day, null)"
                                          OnPlan="() => this.OpenPickerAsync(_Day, null)"
                                          OnDrop="() => this.DropEntryAsync(_Day, null)"
                                          Moving="this.m_MovingEntry"
                                          OnDragStart="this.StartDraggingEntry"
                                          OnSelect="this.OpenEntrySheet" />
                        }
                    }
                </div>

                @* Narrow: one card per day *@
                <div class="lg:hidden flex flex-col gap-3 max-w-3xl mx-auto">
                    @foreach (var _Day in this.WeekDays())
                    {
                        <div class="rounded-2xl border px-4 py-3 @(this.IsToday(_Day) ? "border-recipes/40 bg-ink-900" : "border-ink-800 bg-ink-900/60")">
                            <div class="flex items-baseline gap-2 mb-2">
                                <p class="text-xs font-semibold uppercase tracking-widest @(this.IsToday(_Day) ? "text-recipes" : "text-ink-500")">@_Day.ToString("ddd")</p>
                                <p class="text-sm text-ink-300">@_Day.ToString("d MMM")</p>
                            </div>
                            <div class="flex flex-col divide-y divide-ink-800">
                                @foreach (var _MealSlot in this.m_MealSlots)
                                {
                                    <div class="flex items-center gap-3 py-2">
                                        <p class="w-20 shrink-0 text-sm text-ink-400 truncate">@_MealSlot.Name</p>
                                        <MealPlanCell Class="flex-1 min-w-0"
                                                      AddLabel="@($"Plan {_MealSlot.Name} for {_Day:dddd d MMMM}")"
                                                      Entries="this.EntriesFor(_Day, _MealSlot.MealSlotID)"
                                                      OnPlan="() => this.OpenPickerAsync(_Day, _MealSlot.MealSlotID)"
                                                      OnDrop="() => this.DropEntryAsync(_Day, _MealSlot.MealSlotID)"
                                                      Moving="this.m_MovingEntry"
                                                      OnDragStart="this.StartDraggingEntry"
                                                      OnSelect="this.OpenEntrySheet" />
                                    </div>
                                }
                                @if (this.EntriesFor(_Day, null).Any())
                                {
                                    <div class="flex items-center gap-3 py-2">
                                        <p class="w-20 shrink-0 text-sm text-ink-500 truncate">Not assigned</p>
                                        <MealPlanCell Class="flex-1 min-w-0"
                                                      AddLabel="@($"Plan a meal for {_Day:dddd d MMMM}")"
                                                      Entries="this.EntriesFor(_Day, null)"
                                                      OnPlan="() => this.OpenPickerAsync(_Day, null)"
                                                      OnDrop="() => this.DropEntryAsync(_Day, null)"
                                                      Moving="this.m_MovingEntry"
                                                      OnDragStart="this.StartDraggingEntry"
                                                      OnSelect="this.OpenEntrySheet" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</CascadingValue>

@* Recipe picker *@
<HomeModal @bind-Visible="this.m_ShowPicker" Title="@this.PickerTitle()" OnSubmit="this.SubmitPickerAsync">
    <ChildContent>
        @if (this.m_MealSlots.Count > 0)
        {
            <div class="flex flex-wrap gap-2 mb-4">
                @foreach (var _MealSlot in this.m_MealSlots)
                {
                    <button type="button"
                            aria-pressed="@(this.m_PickerMealSlotID == _MealSlot.MealSlotID)"
                            class="rounded-full border px-4 min-h-[40px] text-sm font-medium transition-colors active:scale-95 @(this.m_PickerMealSlotID == _MealSlot.MealSlotID ? "border-ink-50 bg-ink-50 text-ink-950" : "border-ink-700 bg-ink-800 text-ink-300 hover:text-ink-50")"
                            @onclick="() => this.m_PickerMealSlotID = _MealSlot.MealSlotID">@_MealSlot.Name</button>
                }
            </div>
        }

        @if (this.m_Recipes == null)
        {
            <HomeLoader Class="py-6" />
        }
        else
        {
            var _Candidates = this.PickerRecipes().ToList();

            <HomeTextInput Class="mb-3"
                           AutoComplete="off"
                           Placeholder="Search, or type something new"
                           @bind-Value="this.m_PickerSearch" />

            @if (_Candidates.Count > 0)
            {
                <div class="max-h-72 app-scrollable divide-y divide-ink-800 border border-ink-800 rounded-lg overflow-hidden">
                    @foreach (var _Recipe in _Candidates)
                    {
                        <button type="button"
                                class="w-full text-left px-4 py-3 min-h-[48px] hover:bg-ink-800 transition-colors disabled:opacity-50"
                                disabled="@this.m_Planning"
                                @onclick="() => this.PlanRecipeAsync(_Recipe.RecipeID)">
                            <div class="flex items-center gap-2">
                                <p class="flex-1 min-w-0 truncate text-sm font-medium text-ink-50">@_Recipe.Name</p>
                                @if (this.SuitsPickedMeal(_Recipe))
                                {
                                    <span class="shrink-0 rounded-full bg-recipes/10 px-2 py-0.5 text-xs text-recipes">@this.PickedMealName()</span>
                                }
                            </div>
                            @if (_Recipe.MealSlots.Any())
                            {
                                <p class="text-xs text-ink-500">@(string.Join(" · ", _Recipe.MealSlots.OrderBy(m => m.Sequence).Select(m => m.Name)))</p>
                            }
                        </button>
                    }
                </div>
            }
            else if (this.m_PickerSearch.Trim().Length == 0)
            {
                <p class="text-sm text-ink-500">No recipes in the book yet. Type a name above to start one.</p>
            }

            @* The meal that isn't a recipe yet gets made one on the spot, already tagged with the
               meal it was planned for, because leaving to the Recipes page and back is a plan abandoned. *@
            @if (this.m_PickerSearch.Trim().Length > 0 && !this.PickerSearchMatchesExactly())
            {
                <button type="button"
                        class="mt-3 w-full flex items-center gap-3 rounded-lg border border-dashed border-ink-700 px-4 py-3 min-h-[48px] text-left hover:border-recipes/60 hover:bg-ink-800 transition-colors disabled:opacity-50"
                        disabled="@this.m_Planning"
                        @onclick="this.CreateAndPlanRecipeAsync">
                    <HomeIcon Name="plus" Class="shrink-0 text-recipes" />
                    <span class="min-w-0 text-sm text-ink-50">
                        Add <span class="font-medium">@this.m_PickerSearch.Trim()</span>
                        @if (this.PickedMealName().Length > 0)
                        {
                            <span> as a new @this.PickedMealName().ToLowerInvariant() recipe</span>
                        }
                        else
                        {
                            <span> as a new recipe</span>
                        }
                    </span>
                </button>

                @* Not everything a family eats is cooked from something. A takeaway, leftovers, or
                   a day that is the occasion rather than the food all belong on the week, and
                   making a recipe out of "Father's Day" to get it there would be silly. *@
                <button type="button"
                        class="mt-2 w-full flex items-center gap-3 rounded-lg border border-dashed border-ink-700 px-4 py-3 min-h-[48px] text-left hover:border-ink-500 hover:bg-ink-800 transition-colors disabled:opacity-50"
                        disabled="@this.m_Planning"
                        @onclick="this.PlanOccasionAsync">
                    <HomeIcon Name="calendar" Class="shrink-0 text-ink-400" />
                    <span class="min-w-0">
                        <span class="block text-sm text-ink-50">Just plan <span class="font-medium">@this.m_PickerSearch.Trim()</span></span>
                        <span class="block text-xs text-ink-500">No recipe behind it, for a takeaway or an occasion</span>
                    </span>
                </button>
            }
        }
    </ChildContent>
</HomeModal>

@* Add the visible week to a shopping list *@
<HomeModal @bind-Visible="this.m_ShowAddToList" Title="Add week to shopping list" OnSubmit="this.CreateListAndAddWeekAsync">
    <ChildContent>
        <p class="text-sm text-ink-400 mb-3">Adds the ingredients of the meals planned this week.</p>

        @if (this.m_MealSlots.Count > 0)
        {
            <HomeSelect TValue="long?"
                        Class="mb-4"
                        Label="Which meals"
                        Options="this.MealSlotFilterOptions()"
                        @bind-Value="this.m_ListMealSlotFilter" />
        }

        @if (this.m_AddedRecipeCount != null)
        {
            <p class="text-sm text-shopping mb-3">Added ingredients from @this.m_AddedRecipeCount @(this.m_AddedRecipeCount == 1 ? "recipe" : "recipes").</p>
        }
        @if (this.m_ShoppingLists == null)
        {
            <HomeLoader Class="py-6" />
        }
        else
        {
            @if (this.m_ShoppingLists.Any())
            {
                <div class="divide-y divide-ink-800 border border-ink-800 rounded-lg overflow-hidden">
                    @foreach (var _List in this.m_ShoppingLists)
                    {
                        <button type="button"
                                class="w-full text-left px-4 py-3 min-h-[48px] hover:bg-ink-800 transition-colors disabled:opacity-50"
                                disabled="@this.m_AddingToList"
                                @onclick="() => this.AddWeekToListAsync(_List.ShoppingListID)">
                            <p class="text-sm font-medium text-ink-50">@_List.Name</p>
                            <p class="text-xs text-ink-500">@_List.ItemCount items</p>
                        </button>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-ink-500">No shopping lists yet. Create one below.</p>
            }

            <div class="mt-4 pt-4 border-t border-ink-800">
                <HomeTextInput Label="Or create a new list" AutoComplete="off" @bind-Value="this.m_NewListName" Placeholder="e.g. Weekly shop" />
                <div class="mt-3 flex justify-end">
                    <HomeButton Loading="this.m_AddingToList"
                                Disabled="@string.IsNullOrWhiteSpace(this.m_NewListName)"
                                DisabledReason="Name the list first."
                                OnClick="this.CreateListAndAddWeekAsync">Create &amp; add</HomeButton>
                </div>
            </div>
        }
    </ChildContent>
</HomeModal>

@* The household's own meal vocabulary *@
<HomeModal @bind-Visible="this.m_ShowManageMeals" Title="Your meals" OnSubmit="this.CreateMealSlotAsync" AutoFocus="false">
    <ChildContent>
        <p class="text-sm text-ink-400 mb-3">Name the meals your family actually eats. They order the planner and filter the recipe book.</p>

        @if (this.m_MealSlots.Count > 0)
        {
            <div class="flex flex-col gap-2">
                @foreach (var _MealSlot in this.m_MealSlots)
                {
                    <div class="flex items-center gap-2 rounded-xl border border-ink-800 bg-ink-900 px-3 py-2">
                        <div class="flex flex-col">
                            <button type="button" aria-label="@($"Move {_MealSlot.Name} earlier")"
                                    class="h-6 w-6 rounded text-ink-500 hover:text-ink-50 disabled:opacity-30"
                                    disabled="@(this.m_MealSlots.IndexOf(_MealSlot) == 0)"
                                    @onclick="() => this.MoveMealSlotAsync(_MealSlot, -1)">
                                <HomeIcon Name="chevron-left" Size="xs" Class="rotate-90" />
                            </button>
                            <button type="button" aria-label="@($"Move {_MealSlot.Name} later")"
                                    class="h-6 w-6 rounded text-ink-500 hover:text-ink-50 disabled:opacity-30"
                                    disabled="@(this.m_MealSlots.IndexOf(_MealSlot) == this.m_MealSlots.Count - 1)"
                                    @onclick="() => this.MoveMealSlotAsync(_MealSlot, 1)">
                                <HomeIcon Name="chevron-right" Size="xs" Class="rotate-90" />
                            </button>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium text-ink-50 truncate">@_MealSlot.Name</p>
                            <p class="text-xs text-ink-500">@(_MealSlot.StartsAt == null ? "No usual time" : $"Around {this.DescribeStartsAt(_MealSlot.StartsAt)}")</p>
                        </div>
                        <button type="button" aria-label="@($"Delete {_MealSlot.Name}")"
                                class="p-2 min-h-[44px] min-w-[44px] text-ink-600 hover:text-red-400 transition-colors"
                                @onclick="() => this.DeleteMealSlotAsync(_MealSlot.MealSlotID)">
                            <HomeIcon Name="trash" />
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-sm text-ink-500">No meals yet.</p>
        }

        <div class="mt-4 pt-4 border-t border-ink-800">
            <div class="grid grid-cols-2 gap-3">
                <HomeTextInput Label="New meal" AutoComplete="off" @bind-Value="this.m_NewMealName" Placeholder="e.g. Supper" />
                <div class="flex flex-col gap-1.5">
                    <label for="new-meal-time" class="text-sm font-medium text-ink-300">Usual time (optional)</label>
                    <input id="new-meal-time" type="time"
                           autocomplete="off"
                           class="w-full bg-ink-800 border border-ink-700 rounded-lg px-4 py-3 text-sm text-ink-50 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-ink-300 focus:border-transparent"
                           value="@this.m_NewMealStartsAt"
                           @onchange="e => this.m_NewMealStartsAt = e.Value?.ToString() ?? string.Empty" />
                </div>
            </div>
            <div class="mt-3 flex justify-end">
                <HomeButton Loading="this.m_SavingMeal"
                            Disabled="@string.IsNullOrWhiteSpace(this.m_NewMealName)"
                            DisabledReason="Give the meal a name first."
                            OnClick="this.CreateMealSlotAsync">Add meal</HomeButton>
            </div>
        </div>
    </ChildContent>
</HomeModal>

@* Everything a planned meal can have done to it. In here rather than on the chip, where three
   icon buttons left the recipe name a sliver of a seven-day column. There is room for words. *@
<HomeModal Visible="this.m_SelectedEntry != null"
           VisibleChanged="visible => { if (!visible) this.m_SelectedEntry = null; }"
           Title="@(this.m_SelectedEntry?.Name ?? "Planned meal")">
    <ChildContent>
        @if (this.m_SelectedEntry is { } _Selected)
        {
            <p class="text-sm text-ink-400">
                @_Selected.Date.ToString("dddd d MMMM")@(string.IsNullOrWhiteSpace(_Selected.MealSlotName) ? "" : $" · {_Selected.MealSlotName}")
            </p>

            <div class="mt-4 flex flex-col gap-2">
                @* An occasion has no recipe to open, so it is not offered one. *@
                @if (_Selected.RecipeID is { } _RecipeID)
                {
                    <a href="/recipes/@_RecipeID"
                       class="flex items-center gap-3 rounded-xl border border-ink-800 bg-ink-800/40 px-4 py-3 min-h-[48px] text-sm text-ink-50 transition-colors hover:border-ink-600">
                        <HomeIcon Name="book" Class="shrink-0 text-recipes" />
                        Open the recipe
                    </a>
                }

                <div class="grid grid-cols-2 gap-2">
                    <HomeButton Variant="secondary"
                                Disabled="this.m_MovingEntry"
                                OnClick="() => this.ShiftEntryAsync(new MealPlanShift(_Selected, -1))">
                        <HomeIcon Name="chevron-left" Class="mr-1" />
                        A day earlier
                    </HomeButton>
                    <HomeButton Variant="secondary"
                                Disabled="this.m_MovingEntry"
                                OnClick="() => this.ShiftEntryAsync(new MealPlanShift(_Selected, 1))">
                        A day later
                        <HomeIcon Name="chevron-right" Class="ml-1" />
                    </HomeButton>
                </div>
            </div>

            <div class="mt-4 flex justify-between gap-3">
                <HomeButton Variant="ghost"
                            Class="text-red-400 hover:text-red-300 hover:bg-red-950/40"
                            OnClick="this.RemoveSelectedEntryAsync">
                    <HomeIcon Name="trash" Class="mr-1" />
                    Remove
                </HomeButton>
                <HomeButton Variant="ghost" OnClick="() => this.m_SelectedEntry = null">Done</HomeButton>
            </div>
        }
    </ChildContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
