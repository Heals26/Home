@page "/"
@page "/home"
@inject IViewerClock ViewerClock
@inject IDevicePreferences DevicePreferences

<HomePageTitle />

@* The family board, the tablet's idle face. Everything here is a glance, not a task:
   each tile shows live content and navigates to its pillar. Failures degrade to a
   single quiet banner, never a stack of toasts. *@

<div class="min-h-full max-w-5xl board:max-w-none mx-auto px-6 pt-8 board:pt-4 pb-6 board:pb-2">
    @* Read once, so the date and the clock cannot land either side of a minute boundary and
       disagree with each other. *@
    @{ var _Now = this.TimeProvider.GetLocalNow(); }

    @* The clock sits on the greeting's baseline rather than above it, so the two big pieces of
       type read as one line from across the room. It wraps under on a narrow screen.
       `tabular-nums` stops the digits shuffling sideways as the minute changes. *@
    <header class="mb-8 board:mb-2 flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
        <div class="min-w-0">
            <p class="text-sm font-medium text-ink-400 tracking-wide">@_Now.ToString("dddd d MMMM")</p>
            <h1 class="font-display text-5xl md:text-6xl board:text-5xl text-ink-50 mt-1 board:mt-0">Good @this.GetGreeting().</h1>
        </div>
        <p class="font-display text-4xl md:text-5xl text-ink-50 tabular-nums leading-none">
            @_Now.ToString("h:mm")<span class="ml-1 text-xl md:text-2xl text-ink-400">@_Now.ToString("tt").ToLowerInvariant()</span>
        </p>
    </header>

    @if (this.m_LoadFailed)
    {
        <div class="mb-6 rounded-xl border border-ink-800 bg-ink-900 px-4 py-3 text-sm text-ink-400">
            Some things couldn't load. Pull to refresh, or check the server is running.
        </div>
    }

    @* Two columns only when the screen is genuinely landscape. Upright, halves of a tablet are
       narrower than a phone and every tile starts truncating, so the board runs as one column. *@
    <div class="grid grid-cols-1 rail:grid-cols-2 board:grid-cols-3 gap-4 board:gap-2">

        @* ── Outside ───────────────────────────────────────────────── *@
        <div class="rail:col-span-2 bg-ink-900 border border-ink-800 rounded-2xl p-5 board:p-4">
            <div class="flex items-center gap-2 text-ink-400 mb-3">
                <HomeIcon Name="weather-cloud-sun" Size="lg" />
                <span class="text-xs font-semibold uppercase tracking-widest">Outside</span>
            </div>

            @if (this.m_Weather == null)
            {
                @if (this.m_WeatherFailed)
                {
                    <p class="text-sm text-ink-500 py-2">The forecast isn't answering just now.</p>
                }
                else
                {
                    <div class="h-10 rounded bg-ink-800 w-1/3 animate-pulse"></div>
                }
            }
            else if (!this.m_Weather.HasLocation)
            {
                @* Nothing has gone wrong. This home just hasn't said where it is. *@
                <p class="text-sm text-ink-500 py-2">
                    Tell Home where you live and the forecast shows up here.
                    <a href="/settings" class="text-ink-200 underline underline-offset-4 hover:text-ink-50">Set your location</a>.
                </p>
            }
            else if (this.m_Weather.Current is { } _Current)
            {
                <div class="flex flex-wrap items-center gap-x-8 gap-y-3 board:gap-y-2">
                    <div class="flex items-center gap-4">
                        <HomeIcon Name="@_Current.IconName" Size="3xl" Class="text-ink-200 shrink-0" />
                        <div>
                            <p class="font-display text-4xl md:text-5xl text-ink-50 leading-none">@Temperature(_Current.TemperatureCelsius)</p>
                            <p class="text-sm text-ink-400 mt-1.5">@_Current.Condition · feels @Temperature(_Current.ApparentTemperatureCelsius)</p>
                        </div>
                    </div>

                    @if (this.Today() is { } _Today)
                    {
                        <div class="text-sm text-ink-400">
                            <p>
                                <span class="text-ink-100 font-semibold">@Temperature(_Today.MaximumTemperatureCelsius)</span>
                                <span class="text-ink-600">/</span>
                                @Temperature(_Today.MinimumTemperatureCelsius)
                                <span class="text-ink-600">today</span>
                            </p>
                            @if (_Today.PrecipitationProbabilityPercentage >= 20)
                            {
                                <p class="mt-1">@_Today.PrecipitationProbabilityPercentage% chance of rain</p>
                            }
                        </div>
                    }
                </div>

                @if (this.ForecastStrip().Any())
                {
                    <div class="mt-4 board:mt-2 pt-4 board:pt-2 border-t border-ink-800 grid grid-cols-3 gap-3">
                        @foreach (var _Day in this.ForecastStrip())
                        {
                            <div class="flex items-center gap-3 min-w-0">
                                <HomeIcon Name="@_Day.IconName" Size="2xl" Class="text-ink-400 shrink-0" />
                                <div class="min-w-0">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">@_Day.Date.ToString("ddd")</p>
                                    <p class="text-sm text-ink-200 truncate">
                                        @Temperature(_Day.MaximumTemperatureCelsius)<span class="text-ink-600"> / </span>@Temperature(_Day.MinimumTemperatureCelsius)
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* ── Today's meals ─────────────────────────────────────────── *@
        <a href="/meal-plan" class="group rail:col-span-2 board:col-span-1 bg-ink-900 border border-ink-800 hover:border-ink-700 active:scale-[0.99] rounded-2xl p-5 board:p-4 transition-all">
            <div class="flex items-center justify-between mb-2">
                <span class="flex items-center gap-2 text-recipes">
                    <HomeIcon Name="utensils" Size="lg" />
                    <span class="text-xs font-semibold uppercase tracking-widest">Today's meals</span>
                </span>
                <HomeIcon Name="chevron-right" Class="text-ink-600 group-hover:text-ink-400" />
            </div>

            @if (this.m_Calendar == null)
            {
                <div class="h-9 rounded bg-ink-800 w-1/2 animate-pulse"></div>
            }
            else if (this.TodaysMealsBySlot() is { Count: > 0 } _Slots)
            {
                <div class="flex flex-col gap-1.5">
                    @foreach (var _Slot in _Slots)
                    {
                        <div class="flex items-baseline gap-3 min-w-0">
                            <span class="shrink-0 w-24 text-xs font-semibold uppercase tracking-wider text-ink-500">@_Slot.Name</span>
                            <p class="font-display text-2xl md:text-3xl text-ink-50 truncate">@_Slot.Meals</p>
                        </div>
                    }
                </div>
                @if (this.TomorrowsMeals().Any())
                {
                    <p class="text-sm text-ink-500 mt-3 truncate">Tomorrow: @string.Join(" · ", this.TomorrowsMeals().Select(m => m.Title))</p>
                }
            }
            else
            {
                <p class="font-display text-3xl md:text-4xl text-ink-500">Nothing planned yet.</p>
                <p class="text-sm text-ink-500 mt-2">Tap to plan the week's meals.</p>
            }
        </a>

        @* ── Today and the next few days ────────────────────────────── *@
        <DashboardAgenda Days="this.m_Calendar"
                         Today="this.m_Today"
                         SignedInUserID="this.m_SignedInUserID"
                         OnlyMine="this.m_OnlyMine"
                         OnlyMineChanged="this.SetOnlyMineAsync"
                         OnCompleteTask="this.CompleteActivityAsync" />

        @* ── Shopping ──────────────────────────────────────────────── *@
        <a href="/shopping-lists" class="group bg-ink-900 border border-ink-800 hover:border-ink-700 active:scale-[0.99] rounded-2xl p-5 board:p-4 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="flex items-center gap-2 text-shopping">
                    <HomeIcon Name="shopping-list" Size="lg" />
                    <span class="text-xs font-semibold uppercase tracking-widest">Shopping</span>
                </span>
                <HomeIcon Name="chevron-right" Class="text-ink-600 group-hover:text-ink-400" />
            </div>

            @if (this.m_ShoppingLists == null)
            {
                <div class="space-y-3 py-1 animate-pulse">
                    <div class="h-4 rounded bg-ink-800"></div>
                    <div class="h-4 rounded bg-ink-800 w-2/3"></div>
                </div>
            }
            else if (this.m_ShoppingLists.Count == 0)
            {
                <p class="text-sm text-ink-500 py-2">No lists yet. Tap to start one.</p>
            }
            else
            {
                <div class="divide-y divide-ink-800/60">
                    @foreach (var _List in this.m_ShoppingLists.Take(4))
                    {
                        <div class="flex items-center justify-between gap-3 py-2.5">
                            <p class="text-sm text-ink-100 truncate">@_List.Name</p>
                            <span class="shrink-0 text-xs font-semibold text-shopping bg-shopping/10 rounded-full px-2.5 py-1">
                                @_List.ItemCount @(_List.ItemCount == 1 ? "item" : "items")
                            </span>
                        </div>
                    }
                </div>
            }
        </a>

        @* ── Lights ────────────────────────────────────────────────── *@
        <a href="/lights" class="group bg-ink-900 border border-ink-800 hover:border-ink-700 active:scale-[0.99] rounded-2xl p-5 board:p-4 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="flex items-center gap-2 text-lights">
                    <HomeIcon Name="lightbulb" Size="lg" />
                    <span class="text-xs font-semibold uppercase tracking-widest">Lights</span>
                </span>
                <HomeIcon Name="chevron-right" Class="text-ink-600 group-hover:text-ink-400" />
            </div>

            @if (this.m_LightGroups == null)
            {
                <div class="space-y-3 py-1 animate-pulse">
                    <div class="h-4 rounded bg-ink-800 w-2/3"></div>
                    <div class="h-4 rounded bg-ink-800 w-1/2"></div>
                </div>
            }
            else if (this.m_LightGroups.Count == 0)
            {
                <p class="text-sm text-ink-500 py-2">No lights synced yet. Tap to set them up.</p>
            }
            else
            {
                <div class="flex flex-wrap gap-2 py-1">
                    @foreach (var _Group in this.m_LightGroups.Where(g => g.Lights.Count > 0))
                    {
                        var _OnCount = _Group.Lights.Count(l => l.IsConnected && l.IsOn);
                        <span class="flex items-center gap-2 text-sm rounded-full border px-3 py-1.5 @(_OnCount > 0 ? "border-lights/40 text-ink-100" : "border-ink-800 text-ink-500")">
                            <span class="h-2 w-2 rounded-full @(_OnCount > 0 ? "bg-lights" : "bg-ink-700")"></span>
                            @_Group.Name@(_OnCount > 0 ? $" · {_OnCount} on" : "")
                        </span>
                    }
                </div>
            }
        </a>

        @* ── Recipes ───────────────────────────────────────────────── *@
        <a href="/recipes" class="group bg-ink-900 border border-ink-800 hover:border-ink-700 active:scale-[0.99] rounded-2xl p-5 board:p-4 transition-all">
            <div class="flex items-center justify-between mb-3">
                <span class="flex items-center gap-2 text-recipes">
                    <HomeIcon Name="book" Size="lg" />
                    <span class="text-xs font-semibold uppercase tracking-widest">Recipes</span>
                </span>
                <HomeIcon Name="chevron-right" Class="text-ink-600 group-hover:text-ink-400" />
            </div>

            @if (this.m_Recipes == null)
            {
                <div class="space-y-3 py-1 animate-pulse">
                    <div class="h-4 rounded bg-ink-800 w-3/4"></div>
                    <div class="h-4 rounded bg-ink-800 w-1/2"></div>
                </div>
            }
            else if (this.m_Recipes.Count == 0)
            {
                <p class="text-sm text-ink-500 py-2">No recipes saved yet. Tap to add the first one.</p>
            }
            else
            {
                <div class="divide-y divide-ink-800/60">
                    @foreach (var _Recipe in this.m_Recipes.Take(3))
                    {
                        <p class="text-sm text-ink-100 truncate py-2.5">@_Recipe.Name</p>
                    }
                </div>
                <p class="text-xs text-ink-500 mt-2">@this.m_Recipes.Count in the book</p>
            }
        </a>

        @* ── Family notes ──────────────────────────────────────────── *@
        <div class="rail:col-span-2 board:col-span-1 bg-ink-900 border border-ink-800 rounded-2xl p-5 board:p-4">
            <div class="flex items-center justify-between mb-3">
                <span class="flex items-center gap-2 text-household">
                    <HomeIcon Name="note" Size="lg" />
                    <span class="text-xs font-semibold uppercase tracking-widest">Family notes</span>
                </span>
            </div>

            @if (this.m_Announcements == null)
            {
                <div class="h-4 rounded bg-ink-800 w-1/3 animate-pulse"></div>
            }
            else
            {
                <div class="flex flex-wrap gap-2 mb-3">
                    @foreach (var _Note in this.m_Announcements)
                    {
                        <span class="flex items-center gap-1 max-w-full rounded-full border border-ink-700 bg-ink-800 pl-3 pr-1 py-1">
                            <span class="text-sm text-ink-100 truncate">@_Note.Content</span>
                            <HomeButton IconOnly Size="xs" Variant="bare"
                                        Class="rounded-full text-ink-500 enabled:hover:text-red-400 flex items-center justify-center"
                                        aria-label="Remove note"
                                        OnClick="() => this.DeleteAnnouncementAsync(_Note)">
                                <HomeIcon Name="x" Size="sm" />
                            </HomeButton>
                        </span>
                    }
                    @if (this.m_Announcements.Count == 0)
                    {
                        <span class="text-sm text-ink-600 py-1.5">Nothing pinned. Leave the family a note.</span>
                    }
                </div>
                <div class="flex gap-2">
                    <HomeTextInput Class="flex-1 min-w-0"
                                   maxlength="500"
                                   Placeholder="e.g. Bin night tonight"
                                   AutoComplete="off"
                                   aria-label="New family note"
                                   @bind-Value="this.m_NewAnnouncement"
                                   OnKeyDown="this.OnAnnouncementKeyDown" />
                    <HomeButton OnClick="this.PostAnnouncementAsync"
                                Loading="this.m_PostingAnnouncement"
                                Disabled="@string.IsNullOrWhiteSpace(this.m_NewAnnouncement)">Pin it</HomeButton>
                </div>
            }
        </div>

    </div>
</div>

