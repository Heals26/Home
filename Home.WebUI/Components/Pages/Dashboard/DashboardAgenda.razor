@* Today in time order, then the next few days compressed: the calendar's answer to "what's
   happening" for a screen that is read from across the kitchen. The heading is the link to the
   calendar; the tile itself is not, because it also carries a scope switch and a tick button, and a
   link wrapped around other controls sends half the taps to the wrong place. *@

<div class="rail:col-span-2 board:col-span-1 bg-ink-900 border border-ink-800 rounded-2xl p-5 board:p-4">
    <div class="flex items-center justify-between gap-3 mb-3">
        <a href="/calendar" class="group flex items-center gap-2 text-calendar min-h-[36px]">
            <HomeIcon Name="calendar" Size="lg" />
            <span class="text-xs font-semibold uppercase tracking-widest">Today</span>
            <HomeIcon Name="chevron-right" Size="sm" Class="text-ink-600 group-hover:text-ink-400" />
        </a>
        @if (this.SignedInUserID != null)
        {
            <HomeSegmentedControl TValue="bool"
                                  Options="this.m_ScopeOptions"
                                  Value="this.OnlyMine"
                                  ValueChanged="this.OnlyMineChanged" />
        }
    </div>

    @if (this.Days == null)
    {
        <div class="space-y-3 py-1 animate-pulse">
            <div class="h-4 rounded bg-ink-800"></div>
            <div class="h-4 rounded bg-ink-800 w-3/4"></div>
            <div class="h-4 rounded bg-ink-800 w-1/2"></div>
        </div>
    }
    else
    {
        @if (this.TodayItems().Count == 0)
        {
            <p class="text-sm text-ink-500 py-2">@(this.OnlyMine ? "Nothing on for you today." : "Nothing on today.") <a href="/calendar" class="text-ink-300 underline underline-offset-4 hover:text-ink-50">Add something</a>.</p>
        }
        else
        {
            <div class="divide-y divide-ink-800/60">
                @foreach (var _Item in this.TodayItems())
                {
                    <div class="flex items-center gap-3 py-2.5">
                        <span class="w-14 shrink-0 text-xs font-semibold tabular-nums @(_Item.StartsAt == null ? "text-ink-500" : "text-ink-300")">
                            @(_Item.StartsAt is { } _StartsAt ? CalendarFormat.Time(_StartsAt) : "All day")
                        </span>
                        <span class="h-2 w-2 shrink-0 rounded-full @DotClass(_Item)"></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm truncate @(_Item.IsDone ? "line-through text-ink-500" : "text-ink-100")">@_Item.Title</p>
                            @if (!string.IsNullOrEmpty(_Item.Subtitle) || _Item.People.Count > 0)
                            {
                                <p class="text-xs text-ink-500 truncate">@string.Join(" · ", new[] { _Item.Subtitle }.Concat(_Item.People).Where(s => !string.IsNullOrEmpty(s)))</p>
                            }
                        </div>
                        @if (_Item.Kind == CalendarItemKind.Task && !_Item.IsDone)
                        {
                            <HomeButton Variant="bare"
                                        Size="none"
                                        Class="h-9 w-9 shrink-0 rounded-full border-2 border-ink-600 enabled:hover:border-shopping flex items-center justify-center"
                                        title="@($"Mark {_Item.Title} as done")"
                                        aria-label="@($"Mark {_Item.Title} as done")"
                                        OnClick="() => this.OnCompleteTask.InvokeAsync(_Item)">
                                <HomeIcon Name="check" Class="text-ink-500" />
                            </HomeButton>
                        }
                    </div>
                }
            </div>
        }

        @if (this.NextDays().Any())
        {
            <div class="mt-3 pt-3 border-t border-ink-800 flex flex-col gap-1.5">
                @foreach (var _Day in this.NextDays())
                {
                    var _Items = this.Visible(_Day.Items);

                    <div class="flex items-baseline gap-3 min-w-0">
                        <span class="w-14 shrink-0 text-xs font-semibold uppercase tracking-wider text-ink-500">@CalendarFormat.DayHeading(_Day.Date, this.Today).Replace("Tomorrow", "Tmrw")</span>
                        <p class="text-sm text-ink-300 truncate">
                            @if (_Items.Count == 0)
                            {
                                <span class="text-ink-600">Nothing on</span>
                            }
                            else
                            {
                                @string.Join(" · ", _Items.Take(3).Select(i => i.Title))@(_Items.Count > 3 ? $" +{_Items.Count - 3}" : "")
                            }
                        </p>
                    </div>
                }
            </div>
        }
    }
</div>
