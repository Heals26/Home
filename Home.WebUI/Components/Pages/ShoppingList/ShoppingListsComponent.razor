<HomeCard Title="Lists">
    <ActionsContent>
        <HomeButton Size="sm" OnClick="this.OpenCreateModal">
            <span class="home-icon home-icon-plus h-4 w-4 mr-1 inline-block"></span>
            New list
        </HomeButton>
    </ActionsContent>
    <ChildContent>
        @if (this.m_ShoppingLists == null)
        {
            <HomeLoader Class="py-8" />
        }
        else if (!this.m_ShoppingLists.ShoppingLists.Any())
        {
            <HomeEmptyState Title="No lists yet" Subtitle="Start a list for the next shop">
                <ActionContent>
                    <HomeButton OnClick="this.OpenCreateModal">New list</HomeButton>
                </ActionContent>
            </HomeEmptyState>
        }
        else
        {
            <div class="divide-y divide-ink-800 -mx-5 -mb-5">
                @foreach (var _List in this.m_ShoppingLists.ShoppingLists)
                {
                    <div class="flex items-center gap-1 hover:bg-ink-800 transition-colors group">
                        <button class="flex-1 text-left px-5 py-4"
                                @onclick="() => this.SelectList(_List)">
                            <p class="text-sm font-medium @(this.ShoppingListID == _List.ShoppingListID ? "text-shopping" : "text-ink-50")">@_List.Name</p>
                            <p class="text-xs text-ink-500 mt-0.5">@_List.ItemCount items</p>
                        </button>
                        <button class="px-3 py-4 text-ink-600 hover:text-red-400 transition-colors opacity-0 group-hover:opacity-100"
                                type="button"
                                title="Delete list"
                                @onclick="() => this.DeleteShoppingListAsync(_List.ShoppingListID)">
                            <span class="home-icon home-icon-x h-4 w-4 inline-block"></span>
                        </button>
                    </div>
                }
            </div>
        }
    </ChildContent>
</HomeCard>

<HomeModal @bind-Visible="this.m_ShowCreate" Title="New list">
    <ChildContent>
        <EditForm Model="this.m_CreateRequest" OnValidSubmit="this.CreateShoppingListAsync">
            <HomeTextInput Label="List name"
                           @bind-Value="this.m_CreateRequest!.Name"
                           Placeholder="e.g. Weekly shop" />
            <div class="mt-4 flex justify-end gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowCreate = false">Cancel</HomeButton>
                <HomeButton Type="submit" Loading="this.m_Creating">Add list</HomeButton>
            </div>
        </EditForm>
    </ChildContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
