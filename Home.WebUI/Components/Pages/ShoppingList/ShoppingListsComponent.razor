<HomeCard Title="Lists">
    <ActionsContent>
        <HomeButton Size="sm" OnClick="this.OpenCreateModal">
            <span class="home-icon home-icon-plus h-4 w-4 mr-1 inline-block"></span>
            New list
        </HomeButton>
    </ActionsContent>
    <ChildContent>
        @if (this.m_ShoppingLists == null)
        {
            <HomeLoader Class="py-8" />
        }
        else if (!this.m_ShoppingLists.ShoppingLists.Any())
        {
            <HomeEmptyState Title="No lists yet" Subtitle="Start a list for the next shop">
                <ActionContent>
                    <HomeButton OnClick="this.OpenCreateModal">New list</HomeButton>
                </ActionContent>
            </HomeEmptyState>
        }
        else
        {
            @* Archived lists are hidden rather than gone: the picker stays short during the week,
               and last Christmas's shop is still there to duplicate a year later. *@
            <div class="divide-y divide-ink-800 -mx-5 -mb-5">
                @foreach (var _List in this.VisibleLists())
                {
                    <div class="flex items-center gap-1 hover:bg-ink-800 transition-colors">
                        <button class="flex-1 min-w-0 text-left px-5 py-4"
                                @onclick="() => this.SelectList(_List)">
                            <p class="text-sm font-medium truncate @(this.ShoppingListID == _List.ShoppingListID ? "text-shopping" : "text-ink-50")">@_List.Name</p>
                            <p class="text-xs text-ink-500 mt-0.5">
                                @_List.ItemCount items@(_List.IsArchived ? " · archived" : string.Empty)
                            </p>
                        </button>
                        @* Always visible rather than revealed on hover — a finger has no hover, so
                           a hover-revealed control needs two touches before it does anything. *@
                        <button class="px-3 py-4 min-h-[48px] text-ink-600 hover:text-ink-100 transition-colors"
                                type="button"
                                title="@($"Manage {_List.Name}")"
                                aria-label="@($"Manage {_List.Name}")"
                                @onclick="() => this.OpenManageModal(_List)">
                            <span class="home-icon home-icon-cog h-4 w-4 inline-block"></span>
                        </button>
                    </div>
                }

                @if (this.ArchivedCount() > 0)
                {
                    <button class="w-full px-5 py-3 min-h-[48px] text-left text-xs text-ink-500 hover:text-ink-200 transition-colors"
                            type="button"
                            @onclick="() => this.m_ShowArchived = !this.m_ShowArchived">
                        @(this.m_ShowArchived ? "Hide" : "Show") @this.ArchivedCount() archived
                    </button>
                }
            </div>
        }
    </ChildContent>
</HomeCard>

<HomeModal @bind-Visible="this.m_ShowCreate" Title="New list" OnSubmit="this.CreateShoppingListAsync">
    <ChildContent>
        <HomeTextInput Label="List name"
                       Name="list-name"
                       AutoComplete="off"
                       @bind-Value="this.m_CreateRequest!.Name"
                       Placeholder="e.g. Weekly shop" />
        <div class="mt-4 flex justify-end gap-3">
            <HomeButton Variant="ghost" OnClick="() => this.m_ShowCreate = false">Cancel</HomeButton>
            <HomeButton Loading="this.m_Creating"
                        Disabled="@string.IsNullOrWhiteSpace(this.m_CreateRequest!.Name)"
                        DisabledReason="Name the list first."
                        OnClick="this.CreateShoppingListAsync">Add list</HomeButton>
        </div>
    </ChildContent>
</HomeModal>

@* Manage-list modal: rename, copy, archive, delete. Delete sits apart and last, because it is the
   only one of the four that loses anything. *@
<HomeModal @bind-Visible="this.m_ShowManage" Title="@this.m_ManageName" OnSubmit="this.RenameShoppingListAsync">
    <ChildContent>
        <div class="flex flex-col gap-5">
            <div class="flex flex-col gap-3">
                <HomeTextInput Label="Name"
                               Name="list-name"
                               AutoComplete="off"
                               @bind-Value="this.m_ManageName" />
                <div class="flex justify-end">
                    <HomeButton Size="sm"
                                Loading="this.m_Renaming"
                                Disabled="@string.IsNullOrWhiteSpace(this.m_ManageName)"
                                DisabledReason="A list needs a name."
                                OnClick="this.RenameShoppingListAsync">Rename</HomeButton>
                </div>
            </div>

            <div class="border-t border-ink-800 pt-4 flex flex-col gap-3">
                <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-sm text-ink-200">Copy this list</p>
                        <p class="text-xs text-ink-500">Everything on it, nothing ticked and no prices carried over.</p>
                    </div>
                    <HomeButton Size="sm" Variant="secondary" Loading="this.m_Duplicating" OnClick="this.DuplicateShoppingListAsync">Copy</HomeButton>
                </div>

                <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-sm text-ink-200">@(this.m_ManageIsArchived ? "Bring it back" : "Archive it")</p>
                        <p class="text-xs text-ink-500">
                            @(this.m_ManageIsArchived
                                ? "Puts the list back in the picker."
                                : "Keeps everything, just takes it out of the picker.")
                        </p>
                    </div>
                    <HomeButton Size="sm" Variant="secondary" Loading="this.m_Archiving" OnClick="this.ToggleArchivedAsync">
                        @(this.m_ManageIsArchived ? "Restore" : "Archive")
                    </HomeButton>
                </div>
            </div>

            <div class="border-t border-ink-800 pt-4 flex items-center justify-between gap-3">
                <div class="min-w-0">
                    <p class="text-sm text-ink-200">Delete this list</p>
                    <p class="text-xs text-ink-500">Gone for good, along with everything on it.</p>
                </div>
                <HomeButton Size="sm"
                            Variant="ghost"
                            Class="text-red-400 hover:text-red-300 hover:bg-red-950/40"
                            Loading="this.m_Deleting"
                            OnClick="this.DeleteManagedListAsync">
                    @(this.m_ConfirmingDelete ? "Tap again to delete" : "Delete")
                </HomeButton>
            </div>
        </div>
    </ChildContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
