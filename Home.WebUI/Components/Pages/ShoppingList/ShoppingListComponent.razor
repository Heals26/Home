<HomeCard>
    <TitleContent>
        @if (this.m_ShoppingList != null)
        {
            <h2 class="text-base font-semibold text-ink-50">@this.m_ShoppingList.Name</h2>
        }
        else
        {
            <h2 class="text-base font-semibold text-ink-400">No list selected</h2>
        }
    </TitleContent>
    <ActionsContent>
        @if (this.m_ShoppingList != null)
        {
            <HomeButton Size="sm" OnClick="this.OpenAddItemModal">
                <span class="home-icon home-icon-plus h-4 w-4 mr-1 inline-block"></span>
                Add item
            </HomeButton>
        }
    </ActionsContent>
    <ChildContent>
        @if (this.m_ShoppingList == null)
        {
            <HomeEmptyState Title="Select a list" Subtitle="Choose a shopping list from the left to see its items" />
        }
        else if (!this.m_ShoppingList.Items.Any())
        {
            <HomeEmptyState Title="List is empty" Subtitle="Add the first thing you'll need">
                <ActionContent>
                    <HomeButton OnClick="this.OpenAddItemModal">Add item</HomeButton>
                </ActionContent>
            </HomeEmptyState>
        }
        else
        {
            <div class="divide-y divide-ink-800 -mx-5">
                @foreach (var _Item in this.m_ShoppingList.Items.OrderBy(i => i.Name))
                {
                    <div class="flex items-center gap-4 px-5 py-3">
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-ink-50 truncate">@_Item.Name</p>
                            @if (_Item.Cost.HasValue && _Item.Cost > 0)
                            {
                                <p class="text-xs text-ink-500">$@_Item.Cost.Value.ToString("F2")</p>
                            }
                        </div>
                        @if (_Item.Quantity.HasValue)
                        {
                            <span class="text-sm text-ink-400 shrink-0">qty @_Item.Quantity.Value</span>
                        }
                    </div>
                }
            </div>
            <div class="border-t border-ink-800 pt-4 mt-4 flex justify-between items-center -mx-5 px-5 -mb-5 pb-5">
                <span class="text-sm text-ink-400">Total</span>
                <span class="text-base font-semibold text-ink-50">
                    $@this.m_ShoppingList.Items.Sum(i => (i.Cost ?? 0) * (i.Quantity ?? 1)).ToString("F2")
                </span>
            </div>
        }
    </ChildContent>
</HomeCard>

<HomeModal @bind-Visible="this.m_ShowAddItem" Title="Add item">
    <ChildContent>
        <EditForm Model="this.m_AddItemRequest" OnValidSubmit="this.AddItemAsync">
            <HomeTextInput Label="Name"
                           @bind-Value="this.m_AddItemRequest!.Name"
                           Placeholder="e.g. Milk" />
            <div class="grid grid-cols-2 gap-3 mt-3">
                <HomeTextInput Label="Quantity"
                               @bind-Value="this.m_QuantityInput"
                               Placeholder="e.g. 2" />
                <HomeTextInput Label="Cost ($)"
                               @bind-Value="this.m_CostInput"
                               Placeholder="e.g. 3.50" />
            </div>
            <div class="mt-4 flex justify-end gap-3">
                <HomeButton Variant="ghost" OnClick="() => this.m_ShowAddItem = false">Cancel</HomeButton>
                <HomeButton Type="submit" Loading="this.m_AddingItem">Add item</HomeButton>
            </div>
        </EditForm>
    </ChildContent>
</HomeModal>

<ErrorHandler @ref="this.m_ErrorHandler" />
