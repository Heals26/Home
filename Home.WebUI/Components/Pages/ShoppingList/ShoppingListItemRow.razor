@* One line of a shopping list, split into two targets: the circle ticks, the words open the item.
   The whole row used to tick, which meant reading a line and tapping it to check the amount
   crossed it off instead, and in a supermarket with a trolley that is a mis-tap you have to undo.
   The circle keeps a 56px hit area of its own so the tick target did not shrink to the 24px ring
   you can see, and the pencil is gone because the words now do its job. *@

@* Draggable only where there is a pointer to drag with. Touch fires no drag events, so the row's
   chevrons stay the way a finger reorders and this is the mouse's shortcut for the same move. The
   drop target attribute is what board.js watches for to allow the drop.

   dragenter rather than dragover: dragover fires continuously while the cursor moves, and a C#
   handler on it would be a round trip per mouse movement over every row. dragenter fires once as
   the row is crossed, which is exactly when the line needs to move.

   The line is drawn where the item will land, which is not always the edge nearest the cursor.
   See ShoppingListDropLine. *@
<div class="relative flex items-center hover:bg-ink-800/50 transition-colors @(this.Draggable ? "cursor-grab active:cursor-grabbing" : "") @(this.IsBeingDragged ? "opacity-40" : "")"
     draggable="@(this.Draggable ? "true" : "false")"
     data-drop-target=""
     @ondragstart="() => this.OnDragStart.InvokeAsync(this.Item)"
     @ondragenter="() => this.OnDragEnter.InvokeAsync(this.Item)"
     @ondragend="() => this.OnDragEnd.InvokeAsync()"
     @ondrop="() => this.OnDrop.InvokeAsync(this.Item)">
    @if (this.DropLine != ShoppingListDropLine.None)
    {
        <span aria-hidden="true"
              class="pointer-events-none absolute left-0 right-0 h-0.5 bg-shopping @(this.DropLine == ShoppingListDropLine.Above ? "-top-px" : "-bottom-px")"></span>
    }
    <HomeButton Variant="bare"
                Size="none"
                Class="shrink-0 flex items-center justify-center pl-5 pr-3 py-3 min-h-[56px]"
                aria-pressed="@(this.Item.InBasket ? "true" : "false")"
                aria-label="@(this.Item.InBasket ? $"Untick {this.Item.Name}" : $"Tick {this.Item.Name}")"
                OnClick="() => this.OnToggle.InvokeAsync(this.Item)">
        <span class="h-6 w-6 rounded-full border-2 flex items-center justify-center transition-colors @(this.Item.InBasket ? "border-shopping bg-shopping/20" : "border-ink-600")">
            @if (this.Item.InBasket)
            {
                <HomeIcon Name="check" Size="sm" Class="text-shopping" />
            }
        </span>
    </HomeButton>
    <HomeListRow Class="flex-1 min-w-0 pr-5 pl-0 min-h-[56px] enabled:hover:bg-transparent"
                 aria-label="@($"Edit {this.Item.Name}")"
                 OnClick="() => this.OnEdit.InvokeAsync(this.Item)">
        <span class="block text-sm font-medium truncate @(this.Item.InBasket ? "text-ink-500 line-through" : "text-ink-50")">@this.Item.Name</span>
        @if (this.Detail().Length > 0)
        {
            <span class="block text-xs mt-0.5 @(this.Item.InBasket ? "text-ink-600" : "text-ink-500")">
                @this.Detail()
                @if (this.Item.IsDearerThanUsual && this.Item.UsualCost is { } _Usual)
                {
                    <span class="@(this.Item.InBasket ? "" : "text-caution")">· usually $@_Usual.ToString("F2")</span>
                }
            </span>
        }
        @* Its own line with an icon rather than another entry on the detail line, because this is
           the thing being read at the shelf and it is prose, not a measurement. Two lines at most
           so a long one cannot turn a row into a paragraph. *@
        @if (!string.IsNullOrWhiteSpace(this.Item.Note))
        {
            <span class="flex items-start gap-1.5 mt-1 text-xs @(this.Item.InBasket ? "text-ink-600" : "text-ink-400")">
                <HomeIcon Name="note" Size="sm" Class="shrink-0 mt-px" />
                <span class="min-w-0 line-clamp-2">@this.Item.Note</span>
            </span>
        }
    </HomeListRow>
    @* Only what is still to get can be reordered, because the order of the trolley is history, and the
       list you walk the shop with is the one worth arranging. *@
    @if (this.ShowReorder)
    {
        <HomeReorder Label="@this.Item.Name"
                     CanMoveUp="this.CanMoveUp"
                     CanMoveDown="this.CanMoveDown"
                     OnMoveUp="() => this.OnMoveUp.InvokeAsync(this.Item)"
                     OnMoveDown="() => this.OnMoveDown.InvokeAsync(this.Item)" />
    }
</div>
